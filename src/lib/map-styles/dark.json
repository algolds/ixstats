      },
      "paint": {
        "text-color": [
          "match",
          ["get", "category"],
          "battle",
          "#dc2626",
          "founding",
          "#2563eb",
          "treaty",
          "#16a34a",
          "cultural",
          "#9333ea",
          "religious",
          "#ca8a04",
          "natural",
          "#059669",
          "trade",
          "#ea580c",
          "exploration",
          "#0891b2",
          "disaster",
          "#6b7280",
          "#6b7280"
        ],
