    {
      "id": "ocean-labels",
      "type": "symbol",
      "source": "source-ocean-labels",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["__FONT_REGULAR__"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0.5,
          ["match", ["get", "rank"], "major", 14, "medium", 10, 8],
          3,
          ["match", ["get", "rank"], "major", 20, "medium", 14, 11],
          6,
          ["match", ["get", "rank"], "major", 26, "medium", 18, 14]
        ],
        "text-letter-spacing": ["match", ["get", "rank"], "major", 0.2, "medium", 0.1, 0.05],
        "text-allow-overlap": false,
        "text-max-width": 12,
        "text-padding": 5
      },
      "paint": {
        "text-color": ["match", ["get", "rank"], "major", "#38bdf8", "medium", "#0ea5e9", "#0284c7"],
        "text-halo-color": "rgba(15, 23, 42, 0.6)",
        "text-halo-width": 1,
        "text-opacity": [
          "step",
          ["zoom"],
          ["match", ["get", "rank"], "major", 0.8, 0],
          1.5,
          ["match", ["get", "rank"], "major", 0.9, "medium", 0.7, 0],
          3,
          0.9
        ]
      }
    },
