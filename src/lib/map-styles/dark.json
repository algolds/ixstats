      "source": "source-map-labels",
      "layout": {
        "text-field": ["get", "text"],
        "text-size": ["coalesce", ["get", "fontSize"], 12],
        "text-rotate": ["coalesce", ["get", "rotation"], 0],
        "text-letter-spacing": ["coalesce", ["get", "letterSpacing"], 0],
        "text-font": [
          "case",
          ["==", ["coalesce", ["get", "fontWeight"], "normal"], "bold"],
          ["literal", ["__FONT_BOLD__"]],
          ["literal", ["__FONT_REGULAR__"]]
        ],
        "text-allow-overlap": true
      },
      "paint": {
        "text-color": ["coalesce", ["get", "color"], "#e2e8f0"],
        "text-opacity": ["coalesce", ["get", "opacity"], 1],
        "text-halo-color": "#0f172a",
        "text-halo-width": 1.2
      }
    }
  ]
}
