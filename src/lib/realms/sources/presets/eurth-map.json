{
  "id": "eurth-map",
  "label": "Eurth community map (a-seth-harrison/eurth-map)",
  "description": "Nations, figures, borders and organisations from the Eurth community map. Map figures are forum-checked by the map's maintainer. Continents are a first guess from the map's regions and nearest neighbours: correct them in the continent table.",
  "provider": "github",
  "repo": "a-seth-harrison/eurth-map",
  "ref": "main",
  "format": "eurth-map",
  "intervalHours": null,
  "settings": {
    "files": {
      "nations": "eurth-map/src/data/nations.js",
      "organizations": "eurth-map/src/data/organizations.js",
      "borders": "eurth-map/public/nations.geojson"
    },
    "bindings": {
      "nations": "nations",
      "organizations": "ORGANIZATIONS"
    },
    "nationFields": {
      "officialName": "name",
      "population": "population",
      "gdpPerCapita": "gdppc",
      "landArea": "landArea",
      "capital": "capital",
      "wikiLink": "iiwikiLink",
      "color": "color",
      "secondaryFields": "secondaryFields"
    },
    "organizationFields": {
      "key": "id",
      "name": "name",
      "color": "color",
      "members": "members"
    },
    "featureFields": {
      "key": "id",
      "area": "tracedAreaKm2"
    },
    "acronymInName": true,
    "allianceTypeRules": [
      {
        "keywords": [
          "Treaty",
          "Pact",
          "Defence",
          "Defense",
          "Security"
        ],
        "type": "military"
      },
      {
        "keywords": [
          "Economic"
        ],
        "type": "economic"
      }
    ],
    "defaultAllianceType": "political",
    "wikiSource": "iiwiki",
    "wikiLinkPrefixes": [
      "https://iiwiki.com/w/",
      "https://iiwiki.com/wiki/"
    ],
    "attribution": "Map: Eurth community, via eurth-map by Seth Harrison"
  },
  "options": {
    "addNewNations": true,
    "addRosterNations": true,
    "useWikiInfobox": true,
    "updateUnclaimedStats": true,
    "updateClaimedStats": false,
    "updateBorders": true,
    "syncAlliances": true,
    "applyContinents": true,
    "missingNations": "flag"
  },
  "wiki": {
    "source": "iiwiki",
    "rootCategory": "Category:Eurth",
    "keyword": "Eurth",
    "rosterCategory": "Category:Countries (Eurth)",
    "portalTitle": "Portal:Eurth",
    "mapCategories": []
  },
