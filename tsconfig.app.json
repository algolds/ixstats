{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/trpc/**/*.ts",
    "src/trpc/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
