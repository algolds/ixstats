# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env.local" for development or ".env.production" for production and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Database Configuration
# PostgreSQL with PostGIS (October 2025)
# Connection pool params: connection_limit, pool_timeout, connect_timeout
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ixstats?connection_limit=20&pool_timeout=30&connect_timeout=10"

# Redis Cache Configuration (for rate limiting and general caching)
REDIS_URL="redis://localhost:6379"

# Discord Bot Configuration
# Get these from https://discord.com/developers/applications
DISCORD_BOT_AUTH_KEY="your-bot-auth-key"
DISCORD_BOT_TOKEN="your-discord-bot-token"

# Discord Webhook Configuration (optional)
# Create webhook in Discord: Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"
DISCORD_WEBHOOK_ENABLED="false"

# Environment Configuration
NODE_ENV="development"
PORT=3000

# Application URLs
NEXT_PUBLIC_MEDIAWIKI_URL="https://ixwiki.com/"
IXTIME_BOT_URL="http://localhost:3001"
NEXT_PUBLIC_IXTIME_BOT_URL="http://localhost:3001"

# Clerk Authentication
# Development: Get test keys from https://dashboard.clerk.com -> Your App -> API Keys (Development)
# Production: Get live keys from https://dashboard.clerk.com -> Your App -> API Keys (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_development_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_development_secret_key_here"

# Redis Configuration (optional - for production rate limiting and caching)
# If not configured, falls back to in-memory rate limiting
REDIS_ENABLED="false"

# Rate Limiting Configuration
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# Performance & Optimization
ENABLE_COMPRESSION="true"
ENABLE_CACHING="true"
CACHE_TTL_SECONDS="3600"

# Cron Job Security
# Generate a secure random secret: openssl rand -hex 32
CRON_SECRET="your-secure-random-secret-here"

# NationStates Verification
# Required for NS nation ownership verification during card imports
# Generate with: openssl rand -hex 32
NS_VERIFICATION_SECRET="your-ns-verification-secret-here"

# Optional: Skip environment validation during build
# SKIP_ENV_VALIDATION="true"

# Bot Integration
IXTIME_BOT_SECRET="your-bot-sync-secret"

# Wiki Integration
IXWIKI_LOCAL_PATH="/path/to/ixwiki"

# Application URLs
APP_URL="http://localhost:3000"

# Security (comma-separated Clerk user IDs)
SYSTEM_OWNER_IDS=""

# Encryption
ENCRYPTION_MASTER_PASSWORD=""

# Forum Integration (optional)
XENFORO_API_KEY=""
XENFORO_API_URL=""

# Deployment Paths (production only)
BASE_PATH=""
NEXT_PUBLIC_BASE_PATH=""

# c15t Configuration
NEXT_PUBLIC_C15T_URL=https://your-project.inth.app

# Giphy API key for ThinkPages composer
NEXT_PUBLIC_GIPHY_API_KEY="your-giphy-api-key-here"
