# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env.local" for development or ".env.production" for production and populate it with your secrets.

# When adding additional environment variables, the schema in "src/env.ts"
# should be updated accordingly (src/tests/config/env-example.test.ts checks that
# every key in src/env.ts appears here).

# Database Configuration
# PostgreSQL with PostGIS (October 2025)
# Connection pool params: connection_limit, pool_timeout, connect_timeout
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ixstats?connection_limit=20&pool_timeout=30&connect_timeout=10"

# Redis Cache Configuration (for rate limiting and general caching)
REDIS_URL="redis://localhost:6379"

# Discord Bot Configuration
# Get these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN="your-discord-bot-token"
# Optional: guild used to look up member nicknames for Discord-mirrored ThinkPages reactions
# DISCORD_GUILD_ID="552179975769161729"

# Discord Webhook Configuration (optional)
# Create webhook in Discord: Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"
DISCORD_WEBHOOK_ENABLED="false"

# Environment Configuration
NODE_ENV="development"
PORT=3000

# Application URLs
NEXT_PUBLIC_MEDIAWIKI_URL="https://ixwiki.com/"
IXTIME_BOT_URL="http://localhost:3001"
NEXT_PUBLIC_IXTIME_BOT_URL="http://localhost:3001"

# Clerk Authentication
# Development: Get test keys from https://dashboard.clerk.com -> Your App -> API Keys (Development)
# Production: Get live keys from https://dashboard.clerk.com -> Your App -> API Keys (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_development_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_development_secret_key_here"

# WebSocket (ThinkPages, ws-backend.mjs) - handshake needs a Clerk session token (CLERK_SECRET_KEY above).
# Browser origins allowed besides NEXT_PUBLIC_APP_URL, comma-separated full URLs. In production an
# empty list rejects every browser connection (fails closed).
WS_ALLOWED_ORIGINS="https://ixwiki.com,https://maps.ixwiki.com"

# Redis Configuration (optional - for production rate limiting and caching)
# If not configured, falls back to in-memory rate limiting
REDIS_ENABLED="false"

# Rate Limiting Configuration
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# Performance & Optimization
ENABLE_COMPRESSION="true"

# Cron Job Security
# Generate a secure random secret: openssl rand -hex 32
CRON_SECRET="your-secure-random-secret-here"
# Comma-separated cron job names that cron-runner.mjs may run (empty = none). See src/server/cron/jobs.ts
CRON_ENABLED_JOBS=""

# NationStates Verification
# Required for NS nation ownership verification during card imports
# Generate with: openssl rand -hex 32
NS_VERIFICATION_SECRET="your-ns-verification-secret-here"

# Optional: Skip environment validation during build
# SKIP_ENV_VALIDATION="true"

# Bot Integration
IXTIME_BOT_SECRET="your-bot-sync-secret"

# Wiki Integration
# Loopback api.php of the private MediaWiki render engine (server-side calls use it when set)
# WIKIOS_MEDIAWIKI_INTERNAL_URL="http://127.0.0.1:8081/api.php"

# Application URLs
APP_URL="http://localhost:3000"

# Security (comma-separated Clerk user IDs)
SYSTEM_OWNER_IDS=""

# Kokoro Natural Voice service API key (used to secure the docker container)
KOKORO_API_KEY="your-secure-random-key-here"

# Forum Integration (optional)
XENFORO_API_KEY=""
XENFORO_API_URL=""
# Optional: HMAC key for forum account verification codes (falls back to CRON_SECRET)
# FORUM_VERIFICATION_SECRET=""

# Deployment Paths (production only)
BASE_PATH=""
NEXT_PUBLIC_BASE_PATH=""

# Giphy API key for ThinkPages composer
NEXT_PUBLIC_GIPHY_API_KEY="your-giphy-api-key-here"

# Test builds only: "true" grants MyCountry Premium features (Defense, Intelligence, Map Editor,
# PvP / PvNPC operations) to every signed-in user. Leave unset or "false" in production.
# Inlined into the client bundle at build time, so changing it needs a rebuild.
NEXT_PUBLIC_PREMIUM_FOR_ALL="false"

# ------------------------------------------------------------------------------
# Further settings read by src/env.ts (all optional unless marked)
# ------------------------------------------------------------------------------

# Required in production (the app refuses to boot without these)
# Shared secret MediaWiki sends to /api/wiki/sync-webhook and /api/wikios/inbound-sync
# (header x-wiki-webhook-secret or Authorization: Bearer) - REQUIRED in production
WIKI_SYNC_WEBHOOK_SECRET=""  # at least 32 characters in production

# Application URLs & runtime
# App URL for client-side self-referencing
# NEXT_PUBLIC_APP_URL="false"
# Sign-in page URL for Halo sign-in links (defaults to /sign-in)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=""
# Vercel URL (auto-set by Vercel)
# VERCEL_URL=""
# Directory for uploaded images (defaults to public/images/uploads)
# UPLOAD_DIR=""
# "true" puts the Prisma client in read-only mode (src/server/db.ts)
# DATABASE_READONLY=""
# "true" enables verbose tRPC context/middleware logging
# TRPC_VERBOSE=""
# "true" logs messaging telemetry even under NODE_ENV=test
# DEBUG_TELEMETRY=""

# Realtime
# "true" lets the ThinkPages client open its WebSocket
# NEXT_PUBLIC_ENABLE_WEBSOCKET=""
# Port of the ThinkPages WebSocket server
# NEXT_PUBLIC_WS_PORT=""

# IxWiki / WikiOS
# IxWiki MySQL direct access (for wiki-bridge.ts read queries)
# IXWIKI_DB_HOST="localhost"
# IXWIKI_DB_PORT="ixwiki"
# IXWIKI_DB_USER="ixwiki"
# IXWIKI_DB_PASSWORD="ixwiki"
# IXWIKI_DB_NAME="ixwiki"
# iiwiki api.php proxy URL that overrides the default iiwiki endpoint
# IIWIKI_DEV_PROXY_URL=""
# "true" stops WikiOS from queueing background MediaWiki sync jobs (sync-worker.ts)
# SKIP_MEDIAWIKI_SYNC=""
# MediaWiki api.php URL used for WikiOS writes and CSRF tokens
# WIKIOS_MEDIAWIKI_API=""
# Internal (same-server) ixwiki api.php URL that overrides the public one for reads
# WIKIOS_MEDIAWIKI_INTERNAL_URL=""
# WikiOS MediaWiki Bot Username
# WIKIOS_MEDIAWIKI_BOT_USER="Heku@WikiOS"
# Declared for visibility; call sites still read process.env directly (plan 339).
# MediaWiki bot password (lgpassword) for the WikiOS bot login (csrf-cache.ts)
# WIKIOS_MEDIAWIKI_BOT_TOKEN=""

# Cloudflare
# Cloudflare API token + zone for purging article edge cache on save (both needed)
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ZONE_ID=""
# Cloudflare Turnstile secret for verifying WikiOS challenge tokens
# CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# Discord & bots
# Discord channel mirrored into IxTwitter/ThinkPages (code has a fallback channel)
# DISCORD_IXTWITTER_CHANNEL_ID=""
# Country ID that synced Discord posts are attributed to (falls back to a DB lookup)
# DISCORD_POST_COUNTRY_ID=""
# API key the Discord bot sends to /api/bot/lorewards/sync
# BOT_API_KEY=""

# National issues
# National issues gameplay flags ("0"/"false" off, "1"/"true" on; see gameplay-flags.ts)
# ISSUES_AUTO_GENERATE=""
# ISSUES_AWARD_CREDITS=""
# ISSUES_ENFORCE_DEADLINES=""
# Neighbor-aware national issues; on unless "0"/"false" (national-issues/neighbors.ts)
# ISSUES_NEIGHBORS=""

# Narrator LLM (lore and issues)
# NARRATOR_LLM_PROVIDER=""
# NARRATOR_LLM_API_URL=""
# NARRATOR_LLM_MODEL=""
# Narrator LLM (lib/narrator/client.ts); independent of the SPORTS_LLM_* keys (no fallback)
# NARRATOR_LLM_API_KEY=""
# "true" enables reasoning mode for narrator LLM requests
# NARRATOR_LLM_REASONING=""

# Sports commentary (LLM and TTS)
# Sports commentary LLM (lib/sports/commentary/narrator.ts); "true" enables commentary
# SPORTS_LLM_COMMENTARY=""
# SPORTS_LLM_PROVIDER=""
# SPORTS_LLM_API_URL=""
# SPORTS_LLM_MODEL=""
# SPORTS_LLM_API_KEY=""
# Sports commentary text-to-speech; "true" enables it
# SPORTS_TTS_ENABLED=""
# SPORTS_TTS_API_URL=""
# SPORTS_TTS_API_KEY=""

# Maps, media & feature flags
# Map glyph (font PBF) URL template that overrides the default
# NEXT_PUBLIC_MAP_GLYPHS_URL=""
# "true" for the IxWorld standalone build (maps.ixwiki.com): empty base path
# NEXT_PUBLIC_IXWORLD_STANDALONE=""
# Unsplash API access key for the media image search
# UNSPLASH_ACCESS_KEY=""
