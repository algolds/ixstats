  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.1",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "^6.19.3",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@clerk/clerk-react": "^5.61.8",
    "@hono/node-server": "^1.19.13",
    "body-parser": "^2.2.1",
    "cross-spawn": "^7.0.6",
    "csstype": "3.2.3",
    "glob": "^10.5.0",
    "hono": "^4.12.18",
    "js-yaml": "^4.1.0",
    "minimatch": "^3.1.3",
    "picomatch": "^4.0.4",
    "react-is": "^19.1.3",
    "rimraf": "^5.0.5",
    "tar": "^7.5.2",
    "yaml": "^2.7.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "customExportConditions": [
        ""
      ]
    },
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/?(*.)+(spec|test).ts",
      "**/?(*.)+(spec|test).tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{ts,tsx}",
      "!src/**/index.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "moduleNameMapper": {
      "^server-only$": "<rootDir>/jest-mocks/server-only.ts",
      "^ansi-regex$": "<rootDir>/jest-mocks/ansi-regex.ts",
      "^~/env$": "<rootDir>/jest-mocks/env.ts",
      "^d3-delaunay$": "<rootDir>/jest-mocks/d3-delaunay.ts",
      "^~/trpc/react$": "<rootDir>/jest-mocks/trpc-react.ts",
      "^~/(.*)$": "<rootDir>/src/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^superjson$": "<rootDir>/jest-mocks/superjson.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@t3-oss|zod|node-fetch|d3-delaunay|delaunator|robust-predicates)/)"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "useESM": false,
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true
          }
        }
      ]
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/src/server/api/routers/__tests__/caching-benchmark.test.ts"
    ]
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": false,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals",
      "@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "warn",
      "@typescript-eslint/no-explicit-any": "warn",
      "prefer-const": "warn"
    }
  }
}
