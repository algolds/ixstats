{
  "name": "ixstates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "src/lib/performance-monitor.ts",
    "*.css"
  ],
  "scripts": {
    "add-system-owner": "bun scripts/add-system-owner.ts",
    "audit:arch": "bun scripts/audit/audit-arch.ts",
    "audit:arch:update": "bun scripts/audit/audit-arch.ts --update",
    "audit:components": "bun scripts/audit/audit-components.ts",
    "audit:components:json": "bun scripts/audit/audit-components.ts --json",
    "audit:country-links": "bun scripts/audit/verify-country-links.ts",
    "audit:coverage": "bun scripts/audit/audit-schema-coverage.ts",
    "audit:flags": "bun scripts/audit-flag-urls.ts",
    "audit:flags:prod": "BASE_PATH=/projects/ixstates bun scripts/audit-flag-urls.ts",
    "audit:urls": "bun scripts/audit-production-urls.ts",
    "audit:urls:prod": "BASE_PATH=/projects/ixstates bun scripts/audit-production-urls.ts",
    "audit:v1": "bun scripts/audit/audit-v1.ts",
    "audit:v1:prod": "NODE_ENV=production bun scripts/audit/audit-v1.ts",
    "audit:wiring": "bun scripts/audit/audit-trpc-wiring.ts",
    "audit:wiring:json": "bun scripts/audit/audit-trpc-wiring.ts --json-only",
    "auth:check": "node scripts/setup/check-auth-config.js",
    "auth:check:dev": "NODE_ENV=development node scripts/setup/check-auth-config.js",
    "auth:check:prod": "NODE_ENV=production node scripts/setup/check-auth-config.js",
    "auth:validate:prod": "node scripts/setup/validate-clerk-production.js",
    "build": "./scripts/with-base-path.sh next build && bun run postbuild",
    "build:fast": "SKIP_ENV_VALIDATION=true ./scripts/with-base-path.sh next build && bun run postbuild",
    "build:ixworld": "./scripts/deploy-ixworld.sh",
    "check": "bun run typecheck && echo '✓ Type checking complete. Run bun run build for full validation.'",
    "clean": "rm -rf .next dist build",
    "clean:all": "bun run clean && rm -rf node_modules",
    "cleanup:logs": "bun scripts/cleanup-logs.ts",
    "clerk:config": "echo 'See scripts/clerk-dashboard-config.md for Clerk dashboard configuration'",
    "clerk:setup": "node scripts/setup/setup-clerk-dev.js",
    "db:backup": "bun scripts/setup/backup-db.ts",
    "db:generate": "prisma generate",
    "db:init": "bun scripts/setup/init-db.ts",
    "db:migrate": "echo '⛔ ERROR: db:migrate blocked - database contains production data (82 nations). Use db:migrate:force to override.' && exit 1",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:force": "prisma migrate dev",
    "db:push": "echo '⛔ ERROR: db:push blocked - database contains production data (82 nations). Use db:push:force to override.' && exit 1",
    "db:push:force": "prisma db push",
    "db:reset": "echo '⛔ DANGEROUS: db:reset is PERMANENTLY blocked. This would destroy 82 nations of production data.' && exit 1",
    "db:restore": "bun scripts/setup/restore-db.ts",
    "db:seed": "bun scripts/setup/seed-db.ts",
    "db:seed:packs": "bun prisma/seeds/card-packs.ts",
    "db:seed-issues": "bun prisma/seeds/seed-national-issues.ts",
    "db:seed:sports": "bun scripts/setup/seed-sports-standalone.ts",
    "generate:pack-assets": "bun scripts/setup/generate-pack-assets.ts",
    "db:setup": "bun run db:generate && bun run db:push && bun run db:init",
    "db:studio": "prisma studio",
    "db:studio:prod": "prisma studio",
    "db:sync": "./scripts/sync-prod-db.sh",
    "db:sync:check": "echo 'Checking database sync status...' && bunx prisma validate",
    "db:sync:prod-from-dev": "./scripts/sync-dev-to-prod.sh",
    "db:sync:prod-to-dev": "./scripts/sync-prod-to-dev.sh",
    "db:watch": "./scripts/watch-schema.sh",
    "deploy:local": "./scripts/deploy-local.sh",
    "deploy:prod": "./scripts/deploy-production.sh",
    "deploy:rollback": "./scripts/deployment/rollback-deployment.sh",
    "deploy:staging": "./scripts/deployment/deploy-to-staging.sh",
    "dev": "./start-development.sh",
    "dev:db": "bun run db:setup && bun run dev",
    "dev:ixworld": "NEXT_PUBLIC_IXWORLD_STANDALONE=true ./start-development.sh",
    "dev:local": "./scripts/dev-local.sh",
    "dev:server": "node server.mjs",
    "docs:check": "bun scripts/docs/sync-reference-docs.ts --check",
    "docs:sync": "bun scripts/docs/sync-reference-docs.ts --write",
    "diagnostics": "./scripts/diagnostics/run-diagnostics.sh",
    "diagnostics:bench": "bun scripts/diagnostics/benchmark.ts",
    "diagnostics:build": "./scripts/diagnostics/build-analysis.sh",
    "diagnostics:cache": "bun scripts/diagnostics/cache-test.ts",
    "diagnostics:db": "bun scripts/diagnostics/db-analysis.ts",
    "diagnostics:health": "./scripts/diagnostics/health-check.sh",
    "diagnostics:prod": "./scripts/diagnostics/run-diagnostics.sh --url http://localhost:3550/projects/ixstates",
    "diagnostics:quick": "./scripts/diagnostics/run-diagnostics.sh --skip-db --skip-cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "fresh": "bun run clean:all && bun install && bun run db:setup",
    "ixtwitter:backfill": "bun scripts/backfill-ixtwitter.ts",
    "lint": "eslint src --cache || echo 'Note: Pre-existing lint issues. Build still passes.'",
    "lint:fix": "next lint --fix",
    "lint:manual": "next lint",
    "lint:strict": "eslint src --cache --max-warnings 0",
    "load:all": "./scripts/load-testing/run-all-tests.sh",
    "load:api": "bun scripts/load-testing/test-api-load.ts",
    "load:api:stress": "bun scripts/load-testing/test-api-load.ts --users=200 --duration=60",
    "load:builder": "bun scripts/load-testing/test-builder-flow.ts",
    "load:builder:stress": "bun scripts/load-testing/test-builder-flow.ts --iterations=50 --concurrent=10",
    "load:database": "bun scripts/load-testing/test-database-performance.ts",
    "load:database:stress": "bun scripts/load-testing/test-database-performance.ts --concurrent=20 --iterations=100",
    "load:messaging": "bun scripts/load-testing/test-messaging-load.ts",
    "load:messaging:query": "bun scripts/load-testing/test-messaging-load.ts --mode=query --iterations=100",
    "load:messaging:stress": "bun scripts/load-testing/test-messaging-load.ts --conversations=200 --messages=100 --concurrent=20 --iterations=100",
    "load:quick": "./scripts/load-testing/run-all-tests.sh --quick",
    "load:rate-limiting": "bun scripts/load-testing/test-rate-limiting.ts",
    "post:deploy:validate": "bun scripts/deployment/post-deployment-validation.ts",
    "postbuild": "./scripts/post-build.sh",
    "postinstall": "prisma generate",
    "prebuild": "node ./scripts/write-build-version.js",
    "preproduction": "bun run load:all && bun run verify:production",
    "preview": "bun run build && bun run start:next",
    "redis:start": "./scripts/setup-redis.sh start",
    "redis:stats": "./scripts/setup-redis.sh stats",
    "redis:stop": "./scripts/setup-redis.sh stop",
    "set-admin-role": "bun scripts/set-admin-role.ts",
    "setup:monitoring": "bun scripts/deployment/setup-monitoring.ts",
    "start": "NODE_ENV=production ./scripts/with-base-path.sh node server.mjs",
    "start:next": "NODE_ENV=production ./scripts/with-base-path.sh next start -p ${PORT:-3550}",
    "start:prod": "./start-production.sh",
    "sync:owners": "bun scripts/sync-system-owner-roles.ts",
    "test": "jest",
    "test:all": "bun scripts/audit/run-all-tests.ts",
    "test:builder-perf": "bun scripts/audit/test-builder-performance.ts",
    "test:coverage": "jest --coverage",
    "test:critical": "bun scripts/audit/run-all-tests.ts --only=crud,health,database",
    "test:crud": "bun scripts/audit/test-all-crud-operations.ts",
    "test:db": "bun scripts/audit/verify-database-integrity.ts",
    "test:economics": "bun scripts/audit/verify-economic-calculations.ts",
    "test:health": "bun scripts/audit/test-api-health.ts",
    "test:unit": "bun test src/tests/lib --parallel",
    "test:watch": "jest --watch",
    "test:wiring": "bun scripts/audit/verify-live-data-wiring.ts",
    "ts:build": "tsc --build tsconfig.lib.json tsconfig.server.json",
    "ts:check": "tsc --noEmit -p tsconfig.check.json",
    "ts:check:components": "tsc --noEmit -p tsconfig.components.json",
    "ts:check:lib": "tsc --noEmit -p tsconfig.lib.json",
    "ts:check:server": "tsc --noEmit -p tsconfig.server.json",
    "ts:diagnostics": "tsc --extendedDiagnostics --noEmit -p tsconfig.lib.json",
    "ts:explain": "tsc --explainFiles -p tsconfig.lib.json > traces/explain-files.txt",
    "ts:listfiles": "tsc --listFilesOnly -p tsconfig.lib.json",
    "ts:profile": "tsc --generateCpuProfile traces/tsc-profile.cpuprofile --noEmit -p tsconfig.lib.json",
    "ts:trace": "tsc --generateTrace traces/tsc-trace --noEmit -p tsconfig.lib.json && bunx @typescript/analyze-trace traces/tsc-trace",
    "typecheck": "bun run typecheck:ui && bun run typecheck:server && bun run typecheck:trpc && bun run typecheck:db",
    "typecheck:components": "bun scripts/verification/run-typecheck.ts tsconfig.components.json",
    "typecheck:db": "bun scripts/verification/run-typecheck.ts tsconfig.db.json",
    "typecheck:diag": "bun scripts/verification/run-typecheck.ts tsconfig.typecheck.json --extendedDiagnostics",
    "typecheck:file": "tsc --noEmit --skipLibCheck",
    "typecheck:full": "bun scripts/verification/run-typecheck.ts tsconfig.typecheck.json",
    "typecheck:quick": "bun scripts/verification/run-typecheck.ts tsconfig.check.json",
    "typecheck:server": "bun scripts/verification/run-typecheck.ts tsconfig.server.json",
    "typecheck:trpc": "bun scripts/verification/run-typecheck.ts tsconfig.trpc.json",
    "typecheck:ui": "bun scripts/verification/run-typecheck.ts tsconfig.ui.json",
    "validate:migrations": "bun scripts/audit/validate-migration-safety.ts",
    "validate:schemas": "bun scripts/audit/validate-schema-alignment.ts",
    "validate:script-targets": "bun scripts/audit/validate-script-targets.ts",
    "validate:servers": "./scripts/validate-server-config.sh",
    "verify:environment": "bun scripts/deployment/verify-environment.ts",
    "verify:production": "bun run test:critical && bun run validate:schemas && bun run lint",
    "verify:strict": "bun scripts/verification/verify-strict.ts",
    "websocket:dev": "bun --watch src/server/websocket-server.ts",
    "websocket:server": "bun src/server/websocket-server.ts"
  },
  "dependencies": {
    "@c15t/backend": "^2.2.1",
    "@c15t/dev-tools": "^2.2.1",
    "@c15t/nextjs": "^2.2.1",
