{
  "name": "ixstates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "src/lib/performance-monitor.ts",
    "*.css"
  ],
  "scripts": {
    "build": "./scripts/with-base-path.sh next build && bun run postbuild",
    "prebuild": "node ./scripts/write-build-version.js",
    "build:no-check": "./scripts/with-base-path.sh next build && bun run postbuild",
    "build:fast": "SKIP_ENV_VALIDATION=true ./scripts/with-base-path.sh next build && bun run postbuild",
    "postbuild": "./scripts/post-build.sh",
    "build:ixworld": "./scripts/deploy-ixworld.sh",
    "check": "bun run typecheck && echo '\u2713 Type checking complete. Run bun run build for full validation.'",
    "dev": "./start-development.sh",
    "dev:local": "./scripts/dev-local.sh",
    "deploy:local": "./scripts/deploy-local.sh",
    "dev:ixworld": "NEXT_PUBLIC_IXWORLD_STANDALONE=true ./start-development.sh",
    "redis:start": "./scripts/setup-redis.sh start",
    "redis:stop": "./scripts/setup-redis.sh stop",
    "redis:stats": "./scripts/setup-redis.sh stats",
    "dev:simple": "./start-development.sh",
    "dev:server": "node server.mjs",
    "start": "NODE_ENV=production ./scripts/with-base-path.sh node server.mjs",
    "start:next": "NODE_ENV=production ./scripts/with-base-path.sh next start -p ${PORT:-3550}",
    "start:dev": "./start-development.sh",
    "start:prod": "./start-production.sh",
    "deploy:prod": "./scripts/deploy-production.sh",
    "preview": "bun run build && bun run start:next",
    "lint": "eslint src --cache || echo 'Note: Pre-existing lint issues. Build still passes.'",
    "lint:strict": "eslint src --cache --max-warnings 0",
    "lint:fix": "next lint --fix",
    "lint:manual": "next lint",
    "typecheck": "bun run typecheck:ui && bun run typecheck:server && bun run typecheck:trpc && bun run typecheck:db 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:file": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --noEmit --skipLibCheck",
    "typecheck:components": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --project tsconfig.components.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:client": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:ui": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -p tsconfig.ui.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:server": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:trpc": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -p tsconfig.trpc.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:db": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -p tsconfig.db.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:full": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:quick": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.check.json --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "typecheck:diag": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --extendedDiagnostics --noEmit 2>&1 | tee typecheck-$(date +%Y%m%d-%H%M%S).log",
    "sync:owners": "tsx scripts/sync-system-owner-roles.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "echo '\u26d4 ERROR: db:migrate blocked - database contains production data (82 nations). Use db:migrate:force to override.' && exit 1",
    "db:migrate:force": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "echo '\u26d4 ERROR: db:push blocked - database contains production data (82 nations). Use db:push:force to override.' && exit 1",
    "db:push:force": "prisma db push",
    "db:push:prod": "prisma db push",
    "db:reset": "echo '\u26d4 DANGEROUS: db:reset is PERMANENTLY blocked. This would destroy 82 nations of production data.' && exit 1",
    "db:studio": "prisma studio",
    "db:studio:prod": "prisma studio",
    "db:init": "tsx scripts/setup/init-db.ts",
    "db:setup": "bun run db:generate && bun run db:push && bun run db:init",
    "db:sync": "./scripts/sync-prod-db.sh",
    "db:sync:prod-to-dev": "./scripts/sync-prod-to-dev.sh",
    "db:sync:dev-from-prod": "./scripts/sync-prod-to-dev.sh",
    "db:sync:prod-from-dev": "./scripts/sync-dev-to-prod.sh",
    "db:sync:check": "echo 'Checking database sync status...' && bunx prisma validate",
    "db:watch": "./scripts/watch-schema.sh",
    "db:seed": "tsx scripts/setup/seed-db.ts",
    "db:seed:sports": "tsx scripts/setup/seed-sports-standalone.ts",
    "db:seed-issues": "tsx prisma/seeds/seed-national-issues.ts",
    "db:backup": "tsx scripts/setup/backup-db.ts",
    "db:restore": "tsx scripts/setup/restore-db.ts",
    "add-system-owner": "tsx scripts/add-system-owner.ts",
    "set-admin-role": "tsx scripts/set-admin-role.ts",
    "ixtwitter:backfill": "bun run scripts/backfill-ixtwitter.ts",
    "dev:db": "bun run db:setup && bun run dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf .next dist build",
    "clean:all": "bun run clean && rm -rf node_modules",
    "cleanup:logs": "tsx scripts/cleanup-logs.ts",
    "fresh": "bun run clean:all && bun install && bun run db:setup",
    "websocket:server": "tsx src/lib/websocket-server.ts",
    "websocket:dev": "tsx watch src/lib/websocket-server.ts",
    "auth:check": "node scripts/setup/check-auth-config.js",
    "auth:check:dev": "NODE_ENV=development node scripts/setup/check-auth-config.js",
    "auth:check:prod": "NODE_ENV=production node scripts/setup/check-auth-config.js",
    "auth:validate:prod": "node scripts/setup/validate-clerk-production.js",
    "clerk:setup": "node scripts/setup/setup-clerk-dev.js",
    "clerk:config": "echo 'See scripts/clerk-dashboard-config.md for Clerk dashboard configuration'",
    "validate:servers": "./scripts/validate-server-config.sh",
    "audit:v1": "tsx scripts/audit/audit-v1.ts",
    "audit:urls": "tsx scripts/audit-production-urls.ts",
    "audit:urls:prod": "BASE_PATH=/projects/ixstates tsx scripts/audit-production-urls.ts",
    "audit:flags": "tsx scripts/audit-flag-urls.ts",
    "audit:flags:prod": "BASE_PATH=/projects/ixstates tsx scripts/audit-flag-urls.ts",
    "audit:v1:prod": "NODE_ENV=production tsx scripts/audit/audit-v1.ts",
    "audit:arch": "tsx scripts/audit/audit-arch.ts",
    "audit:arch:update": "tsx scripts/audit/audit-arch.ts --update",
    "audit:components": "tsx scripts/audit/audit-components.ts",
    "audit:components:json": "tsx scripts/audit/audit-components.ts --json",
    "audit:wiring": "tsx scripts/audit/audit-trpc-wiring.ts",
    "audit:wiring:json": "tsx scripts/audit/audit-trpc-wiring.ts --json-only",
    "audit:country-links": "tsx scripts/audit/verify-country-links.ts",
    "audit:country-links:prod": "tsx scripts/audit/verify-country-links.ts",
    "test:all": "tsx scripts/audit/run-all-tests.ts",
    "test:crud": "tsx scripts/audit/test-all-crud-operations.ts",
    "test:health": "tsx scripts/audit/test-api-health.ts",
    "test:db": "tsx scripts/audit/verify-database-integrity.ts",
    "test:economics": "tsx scripts/audit/verify-economic-calculations.ts",
    "test:wiring": "tsx scripts/audit/verify-live-data-wiring.ts",
    "test:builder-perf": "tsx scripts/audit/test-builder-performance.ts",
    "test:critical": "tsx scripts/audit/run-all-tests.ts --only=crud,health,database",
    "validate:schemas": "tsx scripts/audit/validate-schema-alignment.ts",
    "audit:coverage": "tsx scripts/audit/audit-schema-coverage.ts",
    "validate:migrations": "tsx scripts/audit/validate-migration-safety.ts",
    "verify:production": "bun run test:critical && bun run validate:schemas && bun run lint",
    "deploy:staging": "./scripts/deployment/deploy-to-staging.sh",
    "deploy:production": "./scripts/deployment/deploy-to-production.sh",
    "deploy:rollback": "./scripts/deployment/rollback-deployment.sh",
    "verify:environment": "tsx scripts/deployment/verify-environment.ts",
    "post:deploy:validate": "tsx scripts/deployment/post-deployment-validation.ts",
    "setup:monitoring": "tsx scripts/deployment/setup-monitoring.ts",
    "load:all": "./scripts/load-testing/run-all-tests.sh",
    "load:quick": "./scripts/load-testing/run-all-tests.sh --quick",
    "load:api": "tsx scripts/load-testing/test-api-load.ts",
    "load:api:stress": "tsx scripts/load-testing/test-api-load.ts --users=200 --duration=60",
    "load:rate-limiting": "tsx scripts/load-testing/test-rate-limiting.ts",
    "load:database": "tsx scripts/load-testing/test-database-performance.ts",
    "load:database:stress": "tsx scripts/load-testing/test-database-performance.ts --concurrent=20 --iterations=100",
    "load:builder": "tsx scripts/load-testing/test-builder-flow.ts",
    "load:builder:stress": "tsx scripts/load-testing/test-builder-flow.ts --iterations=50 --concurrent=10",
    "load:messaging": "tsx scripts/load-testing/test-messaging-load.ts",
    "load:messaging:stress": "tsx scripts/load-testing/test-messaging-load.ts --conversations=200 --messages=100 --concurrent=20 --iterations=100",
    "load:messaging:query": "tsx scripts/load-testing/test-messaging-load.ts --mode=query --iterations=100",
    "preproduction": "bun run load:all && bun run verify:production",
    "diagnostics": "./scripts/diagnostics/run-diagnostics.sh",
    "diagnostics:health": "./scripts/diagnostics/health-check.sh",
    "diagnostics:bench": "bunx tsx scripts/diagnostics/benchmark.ts",
    "diagnostics:db": "bunx tsx scripts/diagnostics/db-analysis.ts",
    "diagnostics:cache": "bunx tsx scripts/diagnostics/cache-test.ts",
    "diagnostics:build": "./scripts/diagnostics/build-analysis.sh",
    "diagnostics:quick": "./scripts/diagnostics/run-diagnostics.sh --skip-db --skip-cache",
    "diagnostics:prod": "./scripts/diagnostics/run-diagnostics.sh --url http://localhost:3550/projects/ixstates",
    "ts:check": "tsc --noEmit -p tsconfig.check.json",
    "ts:check:lib": "tsc --noEmit -p tsconfig.lib.json",
    "ts:check:server": "tsc --noEmit -p tsconfig.server.json",
    "ts:check:components": "tsc --noEmit -p tsconfig.components.json",
    "ts:check:app": "tsc --noEmit -p tsconfig.app.json",
    "ts:profile": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsc --generateCpuProfile traces/tsc-profile.cpuprofile --noEmit -p tsconfig.lib.json",
    "ts:trace": "tsc --generateTrace traces/tsc-trace --noEmit -p tsconfig.lib.json && npx @typescript/analyze-trace traces/tsc-trace",
    "ts:explain": "tsc --explainFiles -p tsconfig.lib.json > traces/explain-files.txt",
    "ts:diagnostics": "tsc --extendedDiagnostics --noEmit -p tsconfig.lib.json",
    "ts:listfiles": "tsc --listFilesOnly -p tsconfig.lib.json",
    "ts:build": "tsc --build tsconfig.lib.json tsconfig.server.json"
  },
