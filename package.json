    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "html2canvas": "^1.4.1",
    "iconoir-react": "^7.12.1",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.43.0",
    "mysql2": "^3.23.4",
    "next": "16.3.1",
    "papaparse": "^5.6.0",
    "platejs": "^52.3.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "svg-path-parser": "^1.1.0",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
