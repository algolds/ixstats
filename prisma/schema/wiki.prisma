// IxStates — WikiOS & Lorewards models

model WikiCache {
  id          String   @id @default(cuid())
  key         String   @unique
  type        String
  data        String
  countryName String?
  metadata    String?
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime

  @@index([key])
  @@index([type, countryName])
  @@index([expiresAt])
  @@index([countryName])
}

/// Postgres shadow of MediaWiki article wikitext — groundwork for the source-of-truth
/// migration (see plans/WIKIOS.md → MediaWiki Independence Path, Stage 2).
/// Populated read-through on article load (lib/wiki-os/article-store.ts). MediaWiki MySQL
/// stays authoritative; this lets WikiOS keep serving content if MediaWiki is unavailable.
model WikiArticle {
  id           String   @id @default(cuid())
  source       String   @default("ixwiki") // ixwiki | iiwiki | althistory
  title        String                       // normalized DB title (spaces → underscores)
  wikitext     String
  revisionId   Int?                          // MW rev_id this content was synced from
  revTimestamp String?                       // MW rev_timestamp of revisionId
  htmlContent  String?                       // pre-rendered transformed HTML cache (Phase 8)
  htmlSyncedAt DateTime?                     // timestamp when HTML was last rendered
  syncedAt     DateTime @default(now())      // last pull from MediaWiki
  updatedAt    DateTime @updatedAt

  revisions    WikiRevision[]

  @@unique([source, title])
  @@index([source])
  @@map("wiki_articles")
}

/// Append-only local revision history for WikiOS articles (Stage 2b).
/// Written through on save (WikiOS-originated edits) and by the recentchanges
/// sync job (edits made directly on MediaWiki). MediaWiki still owns the canonical
/// revid (mwRevId); this mirrors it so history/diff survive MediaWiki downtime.
model WikiRevision {
  id        String      @id @default(cuid())
  articleId String
  article   WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mwRevId   Int?                          // MediaWiki rev_id (null if MW edit returned none)
  wikitext  String
  author    String?
  summary   String?
  minor     Boolean     @default(false)
  source    String      @default("ixwiki") // ixwiki | iiwiki | althistory
  createdAt DateTime    @default(now())

  @@index([articleId, createdAt])
  @@index([source, mwRevId])
  @@map("wiki_revisions")
}

/// Wiki template registry — cached TemplateData schemas from MediaWiki.
model WikiTemplate {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  category      String?  // navigation, infobox, formatting, maintenance, etc.
  templateData  Json?    // TemplateData JSON schema (params, description, format)
  paramCount    Int      @default(0)
  usageCount    Int      @default(0)
  lastSynced    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([name])
  @@map("wiki_templates")
}

/// A named, color-coded collection of saved wiki pages (Stash).
model Stash {
  id        String      @id @default(cuid())
  userId    String
  name      String      @default("My Stash")
  color     String      @default("#3b82f6")
  icon      String?
  isDefault Boolean     @default(false)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     StashItem[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("lore_stashes")
}

/// A single saved page within a Stash, with optional notes.
model StashItem {
  id          String            @id @default(cuid())
  stashId     String
  pageTitle   String
  pageSlug    String
  contentType String            @default("wiki") // "wiki" | "forum_thread" | "forum_post"
  contentId   Int?                                  // XenForo thread_id or post_id for forum items
  note        String?
  order       Int               @default(0)
  savedAt     DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  stash       Stash             @relation(fields: [stashId], references: [id], onDelete: Cascade)
  annotations StashAnnotation[]

  @@unique([stashId, pageTitle])
  @@index([stashId])
  @@index([pageTitle])
  @@index([contentType])
  @@map("lore_stash_items")
}

/// A text-selection annotation on a saved wiki page.
model StashAnnotation {
  id             String    @id @default(cuid())
  itemId         String
  anchorSelector String
  anchorOffset   Int
  focusSelector  String
  focusOffset    Int
  selectedText   String
  comment        String?
  color          String    @default("#fbbf24")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  item           StashItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("lore_stash_annotations")
}

/// A single Loreward result (daily, weekly, or monthly).
model LorewardEntry {
  id            String   @id @default(cuid())
  date          String
  type          String   // daily, weekly, monthly
  dateStart     String?  // Range start for weekly/monthly (e.g. "2026-03-23")
  dateEnd       String?  // Range end for weekly/monthly (e.g. "2026-03-29")
  winnerUser    String?
  winnerPage    String?
  winnerScore   Int?
  winnerBytes   Int?
  runnerUpUser  String?
  runnerUpPage  String?
  runnerUpScore Int?
  runnerUpBytes Int?
  editCount     Int      @default(0)
  status        String   @default("approved")
  month         String?
  year          Int?
  metadata      String?
  syncedAt      DateTime @default(now())

  @@unique([date, type])
  @@index([winnerUser])
  @@index([runnerUpUser])
  @@index([type])
  @@index([date])
  @@map("loreward_entries")
}

/// Aggregated Loreward stats per wiki user.
model LorewardUserStats {
  id             String   @id @default(cuid())
  username       String   @unique
  dailyWins      Int      @default(0)
  dailyRunnerUps Int      @default(0)
  weeklyWins     Int      @default(0)
  monthlyWins    Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  totalScore     Int      @default(0)
  totalBytes     Int      @default(0)
  lastWinDate    String?
  updatedAt      DateTime @updatedAt

  @@index([totalScore])
  @@index([dailyWins])
  @@map("loreward_user_stats")
}

/// Cross-validation: bot picks vs WikiOS scoring engine picks.
model LorewardCrossValidation {
  id                String   @id @default(cuid())
  date              String   @unique
  botWinner         String?
  botWinnerPage     String?
  botWinnerScore    Int?
  botRunnerUp       String?
  wikiosWinner      String?
  wikiosWinnerPage  String?
  wikiosWinnerScore Int?
  wikiosRunnerUp    String?
  winnersAgree      Boolean  @default(false)
  runnerUpsAgree    Boolean  @default(false)
  wikiosCandidates  String?
  botCandidates     String?
  manualWinner      String?
  createdAt         DateTime @default(now())

  @@map("loreward_cross_validation")
}

enum BlurbPromptStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

model BlurbPrompt {
  id           String             @id @default(cuid())
  title        String
  question     String             @db.VarChar(500)
  slug         String             @unique
  status       BlurbPromptStatus  @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?
  closedAt     DateTime?
  isRecurring  Boolean            @default(false)
  featured     Boolean            @default(false)
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  responses    BlurbResponse[]

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([featured])
  @@map("blurb_prompts")
}

model BlurbResponse {
  id                String       @id @default(cuid())
  promptId          String
  userId            String
  countryId         String
  content           String       @db.VarChar(1000)
  linkedArticles    Json?
  featured          Boolean      @default(false)
  thinkpagesPostId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  prompt  BlurbPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user    User        @relation("UserBlurbResponses", fields: [userId], references: [id])
  country Country     @relation("CountryBlurbResponses", fields: [countryId], references: [id])

  @@unique([promptId, userId])
  @@index([promptId])
  @@index([userId])
  @@index([countryId])
  @@index([featured])
  @@map("blurb_responses")
}

/// A general wiki award or milestone achievement assigned to an article.
model WikiArticleAward {
  id             String   @id @default(cuid())
  pageTitle      String
  pageSlug       String
  category       String   // FEATURED, COLLABORATION, PEER_REVIEW, SPECIAL, EDITOR_MILESTONE
  name           String   // e.g. "Featured Article", "10k Prose Milestone"
  description    String?  // citation or description of the award/milestone
  recipientUsers Json?    // Array of usernames (e.g. ["User1", "User2"])
  awardedAt      DateTime @default(now())
  metadata       String?  // Optional extra JSON string metadata

  @@index([pageTitle])
  @@index([pageSlug])
  @@index([category])
  @@map("wiki_article_awards")
}

