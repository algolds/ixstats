// IxStates — WikiOS & Lorewards models

model WikiCache {
  id          String   @id @default(cuid())
  key         String   @unique
  type        String
  data        String
  countryName String?
  metadata    String?
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime

  @@index([key])
  @@index([type, countryName])
  @@index([expiresAt])
  @@index([countryName])
}

/// Authoritative primary article entity in PostgreSQL (WikiOS Native Engine).
model WikiArticle {
  id                  String               @id @default(cuid())
  slug                String               @default("")
  title               String               // Display title e.g. "Treaty of Oakhaven"
  source              String               @default("ixwiki") // ixwiki | iiwiki | althistory
  status              String               @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED | PROTECTED
  format              String               @default("STRUCTURED_JSON") // STRUCTURED_JSON | MARKDOWN | WIKITEXT | HTML
  
  // Dual-Layer Content Storage
  contentJson         Json?                // Structured Block AST (for 0ms Canvas startup)
  contentHtml         String?              @db.Text // Pre-compiled HTML (for <2ms reads)
  htmlContent         String?              @db.Text // Legacy pre-rendered transformed HTML cache
  wikitext            String               @db.Text // Canonical wikitext representation
  summary             String?              @db.VarChar(500)
  
  // Structured Metadata & Infobox
  infoboxData         Json?                // Structured key-value infobox properties
  readingTime         Int                  @default(1)
  wordCount           Int                  @default(0)
  viewCount           Int                  @default(0)
  leadImageUrl        String?
  redirectTargetSlug  String?              // URL alias target if this article is a redirect
  
  // Author Attribution
  authorId            String?
  author              User?                @relation("WikiArticleAuthor", fields: [authorId], references: [id])
  lastEditorId        String?
  lastEditor          User?                @relation("WikiArticleEditor", fields: [lastEditorId], references: [id])
  
  // Versioning & Lineage
  currentRevId        String?
  revisionId          Int?                 // MW rev_id this content was synced from
  revTimestamp        String?              // MW rev_timestamp of revisionId
  htmlSyncedAt        DateTime?            // timestamp when HTML was last rendered
  syncedAt            DateTime             @default(now()) // last pull from MediaWiki
  mwPageId            Int?                 // Legacy MediaWiki page_id
  mwLatestRevId       Int?                 // Legacy MediaWiki rev_id
  lastMwSyncAt        DateTime?
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  revisions           WikiRevision[]       @relation("ArticleRevisions")
  categories          WikiCategoryMember[] @relation("ArticleCategoryMembers")
  outgoingLinks       WikiLink[]           @relation("SourceArticleLinks")
  incomingLinks       WikiLink[]           @relation("TargetArticleLinks")
  stashItems          StashItem[]          @relation("ArticleStashItems")
  awards              WikiArticleAward[]   @relation("ArticleAwards")

  @@unique([source, title])
  @@index([source, slug])
  @@index([source, status])
  @@index([slug])
  @@index([authorId])
  @@map("wiki_articles")
}

/// Append-only revision ledger for WikiOS articles.
model WikiRevision {
  id               String       @id @default(cuid())
  articleId        String
  article          WikiArticle  @relation("ArticleRevisions", fields: [articleId], references: [id], onDelete: Cascade)
  mwRevId          Int?         // MediaWiki rev_id (null if native WikiOS edit)
  format           String       @default("STRUCTURED_JSON")
  contentJson      Json?
  contentHtml      String?      @db.Text
  wikitext         String       @db.Text
  author           String?
  authorId         String?
  authorUser       User?        @relation("WikiRevisionAuthor", fields: [authorId], references: [id])
  summary          String?
  minor            Boolean      @default(false)
  source           String       @default("ixwiki") // ixwiki | iiwiki | althistory
  parentRevisionId String?
  createdAt        DateTime     @default(now())

  @@index([articleId, createdAt])
  @@index([source, mwRevId])
  @@index([authorId])
  @@map("wiki_revisions")
}

/// Native Directed Link Graph Edge
model WikiLink {
  id              String       @id @default(cuid())
  sourceArticleId String
  sourceArticle   WikiArticle  @relation("SourceArticleLinks", fields: [sourceArticleId], references: [id], onDelete: Cascade)
  
  targetSlug      String       // Normalized target slug e.g. "treaty_of_oakhaven"
  targetArticleId String?      // NULL = Red Link (Broken citation)
  targetArticle   WikiArticle? @relation("TargetArticleLinks", fields: [targetArticleId], references: [id], onDelete: SetNull)
  
  anchorText      String?      // Label displayed on the link
  sectionAnchor   String?      // #Heading anchor
  isExternal      Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@unique([sourceArticleId, targetSlug, sectionAnchor])
  @@index([targetSlug])
  @@index([targetArticleId])
  @@index([sourceArticleId])
  @@map("wiki_links")
}

/// Native Category Tree (DAG)
model WikiCategory {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?              @db.Text
  parentId    String?
  parent      WikiCategory?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    WikiCategory[]       @relation("CategoryHierarchy")
  members     WikiCategoryMember[] @relation("CategoryMembers")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("wiki_categories")
}

model WikiCategoryMember {
  id         String       @id @default(cuid())
  categoryId String
  category   WikiCategory @relation("CategoryMembers", fields: [categoryId], references: [id], onDelete: Cascade)
  articleId  String
  article    WikiArticle  @relation("ArticleCategoryMembers", fields: [articleId], references: [id], onDelete: Cascade)
  sortKey    String?
  createdAt  DateTime     @default(now())

  @@unique([categoryId, articleId])
  @@index([articleId])
  @@index([categoryId])
  @@map("wiki_category_members")
}

/// Native Media Commons Asset
model WikiAsset {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  filename     String
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  blurhash     String?
  
  uploaderId   String?
  uploader     User?    @relation("WikiAssetUploader", fields: [uploaderId], references: [id])
  md5Hash      String   @unique
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([mimeType])
  @@index([uploaderId])
  @@map("wiki_assets")
}

/// Wiki template registry — cached TemplateData schemas and scoped styles.
model WikiTemplate {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  category     String?  // navigation, infobox, formatting, maintenance, etc.
  templateData Json?    // TemplateData JSON schema (params, description, format)
  scopedCss    String?  @db.Text
  paramCount   Int      @default(0)
  usageCount   Int      @default(0)
  lastSynced   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([name])
  @@map("wiki_templates")
}

/// A named, color-coded collection of saved wiki pages (Stash).
model Stash {
  id        String      @id @default(cuid())
  userId    String
  name      String      @default("My Stash")
  color     String      @default("#3b82f6")
  icon      String?
  isDefault Boolean     @default(false)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     StashItem[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("lore_stashes")
}

/// A single saved page within a Stash, with optional notes.
model StashItem {
  id          String            @id @default(cuid())
  stashId     String
  pageTitle   String
  pageSlug    String
  articleId   String?
  article     WikiArticle?      @relation("ArticleStashItems", fields: [articleId], references: [id], onDelete: SetNull)
  contentType String            @default("wiki") // "wiki" | "forum_thread" | "forum_post"
  contentId   Int?                               // XenForo thread_id or post_id for forum items
  note        String?
  order       Int               @default(0)
  savedAt     DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  stash       Stash             @relation(fields: [stashId], references: [id], onDelete: Cascade)
  annotations StashAnnotation[]

  @@unique([stashId, pageTitle])
  @@index([stashId])
  @@index([pageTitle])
  @@index([articleId])
  @@index([contentType])
  @@map("lore_stash_items")
}

/// A text-selection annotation on a saved wiki page.
model StashAnnotation {
  id             String    @id @default(cuid())
  itemId         String
  anchorSelector String
  anchorOffset   Int
  focusSelector  String
  focusOffset    Int
  selectedText   String
  comment        String?
  color          String    @default("#fbbf24")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  item           StashItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("lore_stash_annotations")
}

/// A single Loreward result (daily, weekly, or monthly).
model LorewardEntry {
  id            String   @id @default(cuid())
  date          String
  type          String   // daily, weekly, monthly
  dateStart     String?  // Range start for weekly/monthly (e.g. "2026-03-23")
  dateEnd       String?  // Range end for weekly/monthly (e.g. "2026-03-29")
  winnerUser    String?
  winnerPage    String?
  winnerScore   Int?
  winnerBytes   Int?
  runnerUpUser  String?
  runnerUpPage  String?
  runnerUpScore Int?
  runnerUpBytes Int?
  editCount     Int      @default(0)
  status        String   @default("approved")
  month         String?
  year          Int?
  metadata      String?
  syncedAt      DateTime @default(now())

  @@unique([date, type])
  @@index([winnerUser])
  @@index([runnerUpUser])
  @@index([type])
  @@index([date])
  @@map("loreward_entries")
}

/// Aggregated Loreward stats per wiki user.
model LorewardUserStats {
  id             String   @id @default(cuid())
  username       String   @unique
  dailyWins      Int      @default(0)
  dailyRunnerUps Int      @default(0)
  weeklyWins     Int      @default(0)
  monthlyWins    Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  totalScore     Int      @default(0)
  totalBytes     Int      @default(0)
  lastWinDate    String?
  updatedAt      DateTime @updatedAt

  @@index([totalScore])
  @@index([dailyWins])
  @@map("loreward_user_stats")
}

/// Cross-validation: bot picks vs WikiOS scoring engine picks.
model LorewardCrossValidation {
  id                String   @id @default(cuid())
  date              String   @unique
  botWinner         String?
  botWinnerPage     String?
  botWinnerScore    Int?
  botRunnerUp       String?
  wikiosWinner      String?
  wikiosWinnerPage  String?
  wikiosWinnerScore Int?
  wikiosRunnerUp    String?
  winnersAgree      Boolean  @default(false)
  runnerUpsAgree    Boolean  @default(false)
  wikiosCandidates  String?
  botCandidates     String?
  manualWinner      String?
  createdAt         DateTime @default(now())

  @@map("loreward_cross_validation")
}

enum BlurbPromptStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

model BlurbPrompt {
  id           String             @id @default(cuid())
  title        String
  question     String             @db.VarChar(500)
  slug         String             @unique
  status       BlurbPromptStatus  @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?
  closedAt     DateTime?
  isRecurring  Boolean            @default(false)
  featured     Boolean            @default(false)
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  responses    BlurbResponse[]

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([featured])
  @@map("blurb_prompts")
}

model BlurbResponse {
  id                String       @id @default(cuid())
  promptId          String
  userId            String
  countryId         String
  content           String       @db.VarChar(1000)
  linkedArticles    Json?
  featured          Boolean      @default(false)
  thinkpagesPostId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  prompt  BlurbPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user    User        @relation("UserBlurbResponses", fields: [userId], references: [id])
  country Country     @relation("CountryBlurbResponses", fields: [countryId], references: [id])

  @@unique([promptId, userId])
  @@index([promptId])
  @@index([userId])
  @@index([countryId])
  @@index([featured])
  @@map("blurb_responses")
}

/// A general wiki award or milestone achievement assigned to an article.
model WikiArticleAward {
  id             String       @id @default(cuid())
  articleId      String?
  article        WikiArticle? @relation("ArticleAwards", fields: [articleId], references: [id], onDelete: SetNull)
  pageTitle      String
  pageSlug       String
  category       String   // FEATURED, COLLABORATION, PEER_REVIEW, SPECIAL, EDITOR_MILESTONE
  name           String   // e.g. "Featured Article", "10k Prose Milestone"
  description    String?  // citation or description of the award/milestone
  recipientUsers Json?    // Array of usernames (e.g. ["User1", "User2"])
  awardedAt      DateTime @default(now())
  metadata       String?  // Optional extra JSON string metadata

  @@index([pageTitle])
  @@index([pageSlug])
  @@index([articleId])
  @@index([category])
  @@map("wiki_article_awards")
}

enum DiscussionStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

/// A structured discussion thread on a wiki article (WikiOS Margin)
model WikiDiscussionThread {
  id            String            @id @default(cuid())
  articleTitle  String            // Normalized title (e.g. "Treaty_of_Oakhaven")
  status        DiscussionStatus  @default(OPEN)
  title         String            @db.VarChar(300)
  sectionAnchor String?           // Heading anchor ID (e.g. "Territorial_Boundaries")
  selectedText  String?           // Exact text quote if anchored to highlighted phrase
  anchorOffset  Int?              // Character offset in block
  resolvedAt    DateTime?
  resolvedBy    String?
  createdBy     String            // Author user ID
  countryId     String?           // Optional country affiliation
  teamId        String?           // Optional linked ThinktankGroup ID
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  comments      WikiDiscussionComment[]

  @@index([articleTitle, status])
  @@index([articleTitle, sectionAnchor])
  @@index([teamId])
  @@index([createdBy])
  @@map("wiki_discussion_threads")
}

/// A single comment or reply within a wiki discussion thread
model WikiDiscussionComment {
  id            String               @id @default(cuid())
  threadId      String
  userId        String
  countryId     String?
  content       String               @db.Text
  suggestedEdit String?              // Optional proposed wikitext replacement
  reactions     Json?                // Reaction counts { "👍": 3, "❤️": 1 }
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  thread        WikiDiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId])
  @@map("wiki_discussion_comments")
}

