// IxStates — Base configuration (datasource + generator)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "nativeDistinct", "prismaSchemaFolder"]
  // relationJoins: Uses SQL JOINs instead of separate queries for relations (significant perf improvement)
  // nativeDistinct: Uses native SQL DISTINCT for better deduplication performance
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Uncomment directUrl when using a connection pooler (PgBouncer/Prisma Accelerate):
  // directUrl = env("DIRECT_URL")
}
