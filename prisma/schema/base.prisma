// IxStates — Base configuration (datasource + generator)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "nativeDistinct"]
  // relationJoins: Uses SQL JOINs instead of separate queries for relations (significant perf improvement)
  // nativeDistinct: Uses native SQL DISTINCT for better deduplication performance
}

datasource db {
  provider = "postgresql"
  // The URL lives in prisma.config.ts (Prisma 7); the app connects through the pg adapter in src/server/prisma-adapter.ts.
}
