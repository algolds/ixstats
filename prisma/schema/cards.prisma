// IxStates — IxCards, Vault & Trading models

/// *
///  * MyVault - Personal vault system for IxCredits currency and card collectibles
///  * Replaces legacy IxBank system with enhanced features
model MyVault {
  id                String             @id(map: "MyVault_pkey") @default(cuid())
  userId            String             @unique(map: "MyVault_userId_key")
  credits           Float              @default(0)
  lifetimeEarned    Float              @default(0)
  lifetimeSpent     Float              @default(0)
  vaultLevel        Int                @default(1)
  vaultXp           Int                @default(0)
  loginStreak       Int                @default(0)
  lastLoginDate     DateTime?
  todayEarned       Float              @default(0)
  lastDailyReset    DateTime           @default(now())
  equippedCosmetics String?            @default("") // Comma-separated active cosmetic IDs
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "MyVault_userId_fkey")
  transactions      VaultTransaction[]

  @@index([userId], map: "MyVault_userId_idx")
  @@map("my_vault")
}

/// *
///  * VaultTransaction - Transaction history for IxCredits
///  * Tracks all earning and spending activities
model VaultTransaction {
  id           String   @id @default(cuid())
  vaultId      String
  credits      Float
  balanceAfter Float
  type         String
  source       String
  metadata     Json?
  createdAt    DateTime @default(now())
  idempotencyKey String?  @unique // e.g. "passive:<userId>:<YYYY-MM-DD>"; NULL for ordinary rows
  vault        MyVault  @relation(fields: [vaultId], references: [id], onDelete: Cascade, map: "VaultTransaction_vaultId_fkey")

  @@index([vaultId, createdAt])
  @@index([type, createdAt])
  @@map("vault_transactions")
}

/// *
///  * Card - Core card model with IxStats, NationStates, and Wiki integration
///  * Supports multiple card types and rarity tiers
model Card {
  id               String          @id(map: "Card_pkey") @default(cuid())
  title            String
  slug             String?
  description      String?
  category         LoreCategory?
  subcategory      String?
  artwork          String?
  artworkSource    ArtworkSource?  @default(PROCEDURAL)
  artworkCredit    String?
  rarity           CardRarity
  season           Int             @default(1)
  cardType         CardType
  marketValue      Float           @default(0.0)
  /// The first sale of any copy here; until then an NS card's value keeps its NS bank term.
  firstSoldAt      DateTime?
  totalSupply      Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  nsCardId         Int?
  nsSeason         Int?
  wikiSource       String?
  wikiArticleTitle String?
  wikiExcerpt      String?
  countryId        String?
  metadata         Json?
  isRetired        Boolean         @default(false)
  retiredAt        DateTime?
  lorewardEntryId  String?
  lorewardEdition  String?
  /// Its number within its home realm (silhouettes show it). Set by the `cards_assign_collector_number` trigger.
  collectorNumber  Int?
  reviewState          CardReviewState   @default(APPROVED)
  reviewedAt           DateTime?
  /// DB user id of the admin (or realm owner) who reviewed it.
  reviewedBy           String?
  specialKind          SpecialCardKind?
  /// The achievement whose unlock awards this Special card.
  rewardAchievementKey String?           @unique
  artLicence           CardArtLicence?
  takedowns            CardTakedown[]
  /// The card's home realm, kept forever (cards refresh §2.1). Ixnay is "default".
  realmId          String
  realm            Realm           @relation(fields: [realmId], references: [id], onDelete: Restrict)
  /// Bound cards (trophies, achievement rewards) cannot be traded, listed, dusted or fused.
  isBound          Boolean         @default(false)
  CardOwnership    CardOwnership[]
  valueHistory     CardValueHistory[]
  watchlist        CardWatchlist[]
  auctions          CardAuction[]
  listings          CardListing[]
  marketPrices      CardMarketPrice[]
  notificationMutes CardNotificationMute[]

  @@unique([nsCardId, nsSeason])
  @@unique([lorewardEntryId, lorewardEdition])
  @@unique([realmId, collectorNumber])
  @@index([cardType, rarity, season])
  @@index([category, rarity, season])
  @@index([marketValue])
  @@index([countryId])
  @@index([slug])
  @@index([rarity], map: "Card_rarity_idx")
  @@index([season], map: "Card_season_idx")
  @@index([realmId])
  @@index([reviewState, realmId])
  @@map("cards")
}

/// *
///  * NSVerification - NationStates nation ownership verification
///  * Tracks verification attempts for NS deck imports
model NSVerification {
  id               String    @id
  userId           String
  nationName       String
  verificationCode String
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "NSVerification_userId_fkey")

  @@index([userId], map: "NSVerification_userId_idx")
  @@index([expiresAt], map: "NSVerification_expiresAt_idx")
  @@map("ns_verifications")
}

model AuctionBid {
  id          String      @id
  auctionId   String
  bidderId    String
  amount      Int
  createdAt   DateTime    @default(now())
  CardAuction CardAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  User        User        @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([bidderId])
}

model CardAuction {
  id              String            @id
  /// The auctioned copy; null once it is gone (broken down or fused after the auction), so the auction stays.
  /// A running auction always has it: the copy is locked. Admin revoke still refuses a copy with any auction.
  cardInstanceId  String?
  /// The copy's card and serial, stored so the auction (and the seller's sales) outlive the copy.
  cardId          String
  serialNumber    Int
  sellerId        String
  startingPrice   Int
  currentBid      Int
  buyoutPrice     Int?
  currentBidderId String?
  winnerId        String?
  finalPrice      Int?
  bidCount        Int               @default(0)
  status          CardAuctionStatus @default(ACTIVE)
  isFeatured      Boolean           @default(false)
  /// What the seller paid to list; an unsold end refunds a share of it.
  listingFee      Int               @default(0)
  endTime         DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  AuctionBid      AuctionBid[]
  CardOwnership   CardOwnership?    @relation(fields: [cardInstanceId], references: [id], onDelete: SetNull)
  card            Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  User            User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([endTime])
  @@index([sellerId])
  @@index([status])
  @@index([cardInstanceId])
  @@index([cardId, status])
}

model CardCollection {
  id          String               @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean              @default(false)
  /// Set when the owner pins it; the latest pin is the player's showcase (wallet, Passport).
  pinnedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now())
  User        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CardCollectionItem[]

  @@index([userId])
  @@index([userId, pinnedAt])
}

model CardCollectionItem {
  id              String         @id @default(cuid())
  collectionId    String
  cardOwnershipId String
  addedAt         DateTime       @default(now())
  collection      CardCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  cardOwnership   CardOwnership  @relation(fields: [cardOwnershipId], references: [id], onDelete: Cascade)

  @@unique([collectionId, cardOwnershipId])
  @@index([collectionId])
  @@index([cardOwnershipId])
}

model CardOwnership {
  id            String        @id @default(cuid())
  cardId        String
  ownerId       String
  serialNumber  Int
  level         Int           @default(1)
  experience    Int           @default(0)
  isLocked      Boolean       @default(false)
  finish        CardFinish    @default(STANDARD)
  acquiredAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())
  inscription   String?       @db.VarChar(60)
  inscribedById String?
  inscribedAt   DateTime?
  /// The signer's display name at signing, frozen (shown while their Passport shows Vault cards). Null on the older
  /// inscriptions, which show the signer's current name.
  inscribedName    String?
  /// An imported NS copy (or a copy fused from one): it breaks down for the import share of the dust.
  importDiscounted Boolean   @default(false)
  /// The UTC day `xpToday` counts for; the daily XP cap per copy resets when it changes.
  xpDay            DateTime? @db.Date
  xpToday          Int       @default(0)
  CardAuction        CardAuction[]
  collectionItems    CardCollectionItem[]
  cards              Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  User               User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transferEvents     CardTransferEvent[]
  experienceEvents   CardExperienceEvent[]
  listings           CardListing[]
  inscriptionReports CardInscriptionReport[]

  @@unique([cardId, serialNumber])
  @@index([cardId])
  @@index([ownerId])
}

model CardPack {
  id               String     @id @default(cuid())
  name             String
  description      String?
  artwork          String?
  packType         String
  priceCredits     Int
  cardCount        Int
  guaranteedRarity String?
  isActive         Boolean    @default(true)
  commonOdds       Float      @default(65.0)
  uncommonOdds     Float      @default(25.0)
  rareOdds         Float      @default(7.0)
  ultraRareOdds    Float      @default(2.0)
  epicOdds         Float      @default(0.9)
  legendaryOdds    Float      @default(0.1)
  season           Int?
  cardType         CardType?
  themeFilter      Json?
  limitedQuantity  Int?
  purchaseLimit    Int?
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now())
  UserPack         UserPack[]

  @@index([isActive], map: "CardPack_isActive_idx")
  @@index([packType, isActive], map: "CardPack_packType_isActive_idx")
  @@index([season], map: "CardPack_season_idx")
  @@index([cardType], map: "CardPack_cardType_idx")
}

model UserPack {
  id             String    @id @default(cuid())
  userId         String
  packId         String
  isOpened       Boolean   @default(false)
  acquiredMethod String    @default("PURCHASE")
  acquiredDate   DateTime  @default(now())
  openedAt       DateTime?
  pack           CardPack  @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([packId])
  @@map("user_packs")
}

model SyncLog {
  id             String    @id @default(cuid())
  syncType       String
  status         String
  itemsProcessed Int       @default(0)
  itemsFailed    Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  season         Int?
  cardsProcessed Int?
  cardsCreated   Int?
  cardsUpdated   Int?
  errors         String?
  metadata       Json?

  @@index([syncType, status])
  @@map("sync_logs")
}

model LoreCardRequest {
  id              String        @id @default(cuid())
  userId          String
  articleTitle    String
  wikiSource      String
  realmId         String?
  category        LoreCategory?
  suggestedRarity CardRarity?
  status          String        @default("PENDING")
  cardId          String?
  adminNotes      String?
  requestedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  generatedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([wikiSource])
  @@index([realmId])
  @@map("lore_card_requests")
}

model CardValueHistory {
  id          String   @id @default(cuid())
  cardId      String
  value       Float
  recordedAt  DateTime @default(now())
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([recordedAt])
  @@map("card_value_history")
}

/// Card Experience Event Model
/// Tracks XP grants for audit and history purposes
model CardExperienceEvent {
  id           String   @id @default(cuid())
  ownershipId  String
  amount       Int
  resultLevel  Int
  resultXP     Int
  source       String   // a CardXpSource (src/lib/cards/xp-utils.ts); older rows may hold "AUCTION_COMPLETE" or "BUYOUT"
  metadata     String?  // JSON string with additional context
  createdAt    DateTime @default(now())
  ownership    CardOwnership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@index([ownershipId, createdAt])
  @@index([source])
  @@map("card_experience_events")
}

/// Trade Offer Model
/// P2P card trading system
model TradeOffer {
  id                 String    @id @default(cuid())
  initiatorId        String
  recipientId        String
  initiatorCardIds   Json      // Array of CardOwnership IDs
  recipientCardIds   Json      // Array of CardOwnership IDs
  initiatorCredits   Int       @default(0)
  recipientCredits   Int       @default(0)
  status             TradeOfferStatus
  message            String?
  /// The party who wrote the current table; their give-side cards are the locked ones. The other party responds.
  proposerId         String
  /// Bumped by every counter-offer; accept and counter name the revision they saw.
  revision           Int              @default(0)
  /// Stored at accept (spec §2.2 cross-realm rule); Phase 5's dividend and XP bonus read it.
  isCrossRealm       Boolean          @default(false)
  expiresAt          DateTime
  respondedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  initiator          User      @relation("TradeInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipient          User      @relation("TradeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([initiatorId])
  @@index([recipientId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model VaultStoreItem {
  id           String                   @id @default(cuid())
  name         String
  description  String?
  price        Float
  icon         String                   @default("Sparkles")
  glowColor    String?
  quality      String                   @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY
  badgeText    String?
  category     String                   @default("cosmetics") // cosmetics | upgrades
  isActive     Boolean                  @default(true)
  effects      Json?                    // Custom effects/modifiers JSON
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  priceHistory VaultStorePriceHistory[]

  @@map("vault_store_items")
}

model VaultStorePriceHistory {
  id        String         @id @default(cuid())
  itemId    String
  price     Float
  changedAt DateTime       @default(now())
  adminId   String
  adminName String
  item      VaultStoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("vault_store_price_history")
}

model CardWatchlist {
  id          String   @id @default(cuid())
  userId      String
  cardId      String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
  @@map("card_watchlist")
}

model CardTransferEvent {
  id           String         @id @default(cuid())
  /// Null once the copy is gone (revoked, voided, broken down or fused); `cardId` and `serialNumber` keep the trail.
  ownershipId  String?
  cardId       String?
  serialNumber Int?
  /// The copy's finish when the event happened (the market median is per finish).
  finish       CardFinish?
  fromUserId   String?
  /// Null when the copy leaves every player (REVOKE, VOID, BREAKDOWN, a fusion's spent copies).
  toUserId     String?
  action       String   // a mint source (src/lib/cards/mint.ts MINT_SOURCES: "PACK_OPEN" | "DAILY_CLAIM" | "NS_DECK_IMPORT" | "ACHIEVEMENT" | "TROPHY" | "SPORTS" | "ADMIN") | "TRADE" | "GIFT" | "AUCTION_BUYOUT" | "AUCTION_END" | "LISTING_SALE" | "REVOKE" | "REASSIGN" | "VOID" | "REISSUE" | "BREAKDOWN" | "FUSE" | "CRAFT"
  price        Int?
  createdAt    DateTime @default(now())

  ownership    CardOwnership? @relation(fields: [ownershipId], references: [id], onDelete: SetNull)

  @@index([ownershipId])
  // The sales record reads by card, action and date; the prefix serves the lookups by card
  @@index([cardId, action, createdAt])
  @@map("card_transfer_events")
}

/// One NationStates card import ever made (cards refresh §2.2): a nation's card imports once, across all accounts.
model NSImportLedger {
  id          String   @id @default(cuid())
  nsCardId    Int
  nsSeason    Int
  /// The importing nation, normalised by `nsNationKey` (src/lib/cards/ns-facts.ts).
  nation      String
  /// The importer (User.id); null for a backfilled row whose importer is unknown.
  userId      String?
  /// The copy the import minted.
  ownershipId String?
  importedAt  DateTime @default(now())

  @@unique([nsCardId, nsSeason, nation])
  @@index([userId])
  @@map("ns_import_ledger")
}

/// The lead image's provenance and licence, recorded at import (licensing drafts §2.5(b)).
model CardArtLicence {
  cardId         String            @id
  card           Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// The source wiki (`CardWikiSource`).
  wiki           String
  fileTitle      String?
  fileUrl        String?
  descriptionUrl String?
  licence        String?
  licenceUrl     String?
  status         CardLicenceStatus @default(UNKNOWN)
  artist         String?
  /// The credit line shown with the art.
  attribution    String?
  note           String?
  reviewedBy     String?
  reviewedAt     DateTime?
  importedBy     String?
  importJobId    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@map("card_art_licences")
}

/// A server-side import: one item per page or file, worked through by the card-import-jobs cron.
model CardImportJob {
  id           String              @id @default(cuid())
  /// `CardWikiSource`.
  source       String
  kind         CardImportJobKind   @default(MANUAL)
  status       CardImportJobStatus @default(QUEUED)
  label        String
  /// DB user id; null for the daily cron.
  requestedBy  String?
  requireImage Boolean             @default(false)
  total        Int                 @default(0)
  processed    Int                 @default(0)
  staged       Int                 @default(0)
  skipped      Int                 @default(0)
  blocked      Int                 @default(0)
  failed       Int                 @default(0)
  error        String?
  createdAt    DateTime            @default(now())
  startedAt    DateTime?
  heartbeatAt  DateTime?
  finishedAt   DateTime?
  items        CardImportItem[]

  @@index([status, createdAt])
  @@map("card_import_jobs")
}

model CardImportItem {
  id        String               @id @default(cuid())
  jobId     String
  job       CardImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title     String
  status    CardImportItemStatus @default(QUEUED)
  cardId    String?
  rarity    CardRarity?
  licence   String?
  reason    String?
  updatedAt DateTime             @updatedAt

  @@unique([jobId, title])
  @@index([jobId, status])
  @@map("card_import_items")
}

/// One removal request for a card's art, from any source, answered within 14 days (licensing drafts §2.5(f)).
model CardTakedown {
  id                String             @id @default(cuid())
  cardId            String
  card              Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  origin            CardTakedownOrigin
  status            CardTakedownStatus @default(OPEN)
  reason            String
  contact           String?
  /// DB user id of whoever filed it.
  requestedBy       String?
  receivedAt        DateTime           @default(now())
  dueAt             DateTime
  /// The art the card had when it was hidden; restore puts it back.
  savedArtwork      String?
  /// True when hiding retired the card (so restore un-retires it); false when it was retired already.
  retiredByTakedown Boolean            @default(false)
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionNote    String?
  createdAt         DateTime           @default(now())

  @@index([status, dueAt])
  @@index([cardId])
  @@map("card_takedowns")
}

/// A fixed-price listing of one copy. The copy is locked while the listing is ACTIVE.
model CardListing {
  id           String            @id @default(cuid())
  /// The listed copy; null once it is gone (broken down or fused after the sale), so the listing stays.
  ownershipId  String?
  cardId       String
  /// The copy's serial and finish, stored so a finished listing outlives its copy.
  serialNumber Int
  finish       CardFinish
  sellerId     String
  price        Int
  isFeatured   Boolean           @default(false)
  /// What the seller paid to list; cancel and expiry refund a share of it.
  listingFee   Int
  status       CardListingStatus @default(ACTIVE)
  buyerId      String?
  soldAt       DateTime?
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  ownership    CardOwnership?    @relation(fields: [ownershipId], references: [id], onDelete: SetNull)
  card         Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  seller       User              @relation("CardListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, isFeatured, createdAt])
  @@index([status, expiresAt])
  @@index([sellerId, status])
  @@index([cardId, status])
  @@index([ownershipId])
  @@map("card_listings")
}

/// Dust of one realm, held by one account. Account-bound: it never moves between players.
model CardDustBalance {
  userId    String
  realmId   String
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  realm     Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)

  @@id([userId, realmId])
  @@index([realmId])
  @@map("card_dust_balances")
}

/// The dust ledger: one row per copy broken down and per craft.
model CardDustEvent {
  id           String   @id @default(cuid())
  userId       String
  realmId      String
  delta        Int
  balanceAfter Int
  source       String // "BREAKDOWN" | "CRAFT"
  cardId       String?
  ownershipId  String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("card_dust_events")
}

/// The market median per card and finish (the last sales in the window), rebuilt by the card-values cron.
model CardMarketPrice {
  cardId     String
  finish     CardFinish
  median     Float
  sales      Int
  computedAt DateTime   @default(now())
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, finish])
  @@map("card_market_prices")
}

/// A player's per-card mute: no card notices about this card.
model CardNotificationMute {
  userId    String
  cardId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@map("card_notification_mutes")
}

/// A report of a copy's inscription, for the admin queue.
model CardInscriptionReport {
  id          String        @id @default(cuid())
  ownershipId String
  reporterId  String // User.id
  text        String        @db.VarChar(60)
  reason      String        @db.VarChar(500)
  status      String        @default("open") // "open" | "cleared" | "dismissed"
  handledBy   String?
  handledAt   DateTime?
  createdAt   DateTime      @default(now())
  ownership   CardOwnership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@unique([ownershipId, reporterId])
  @@index([status, createdAt])
  @@map("card_inscription_reports")
}
