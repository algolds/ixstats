// IxStates — Exchange (market & corporate system)
//
// Phase 1 (P0) data model, extended by Phase 3 (realm-scoped companies, sectors and contracts,
// nation treasuries, the two-sided order book and shareholder governance). See Exchange_v1_PRD.md §9
// and docs/specs/2026-11-01-exchange-phase-3-design.md.
// Wallets are global per user. Every market object carries realmId (default "default", Ixnay).
// Columns that point at Realm, Country or User are plain strings with indexes, not foreign keys,
// so backfills on populated tables cannot fail on a missing parent.
// Conventions mirror cards.prisma (MyVault / VaultTransaction / CardValueHistory):
//   - cuid() string ids, createdAt/updatedAt wall-clock audit columns
//   - String columns for type/status/direction (allowed values documented inline),
//     matching VaultTransaction.type / CardAuction.status
//   - *IxTime / ixTime columns are Float epoch-ms of REAL time (Date.now()) since the realm time
//     switch (2026-10, scripts/migrations/2026-10-realm-time/t3-platform-real-time.sql); the names
//     are historical. The exchange is platform-wide, so it runs on no realm's clock.
//   - Sovereign wallet is isolated from MyVault to protect the IxCredits economy

/// Per-user Sovereign (₷) wallet — Exchange's own currency, isolated from MyVault/IxCredits.
model ExchangeWallet {
  id             String                @id @default(cuid())
  userId         String                @unique
  sovereigns     Float                 @default(0)
  lifetimeEarned Float                 @default(0)
  lifetimeSpent  Float                 @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   ExchangeTransaction[]

  @@index([userId])
  @@map("exchange_wallets")
}

/// Sovereign transaction ledger. type: CONVERT_IN | CONVERT_OUT | CHARTER_FEE |
/// COMPANY_DEPOSIT | COMPANY_WITHDRAW | SHARE_BUY | SHARE_SELL | CONTRACT_PAYOUT |
/// SECTOR_BUY | SECTOR_SELL | ADMIN_ADJUSTMENT, plus the MyClub types in exchange-service.ts.
/// idempotencyKey: a retried move with the same key is applied once (NULL for ordinary rows).
model ExchangeTransaction {
  id             String         @id @default(cuid())
  walletId       String
  sovereigns     Float
  balanceAfter   Float
  type           String
  source         String
  metadata       Json?
  ixTime         Float
  createdAt      DateTime       @default(now())
  idempotencyKey String?        @unique
  wallet       ExchangeWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type, createdAt])
  @@map("exchange_transactions")
}

/// A player-founded company, scoped to a realm. Priced by the sim (fairValue) and traded on
/// the order book. status: ACTIVE | DISTRESSED | BANKRUPT | DELISTED. name is unique within a
/// realm. hqCountryId is the nation whose tax, interest and treasury rules apply.
model Company {
  id                    String                @id @default(cuid())
  realmId               String                @default("default")
  founderId             String
  name                  String
  sectorKey             String
  subIndustryKey        String                @default("software_media")
  hqCountryId           String?
  capital               Float                 @default(0)
  standing              Float                 @default(0)
  fairValue             Float                 @default(0)
  sharesIssued          Int                   @default(0)
  sharesOutstanding     Int                   @default(0)
  contractsWonValue     Float                 @default(0)
  /// Founder control: new listings and share purchases are allowed only while true.
  tradingOpen           Boolean               @default(false)
  /// Fair value added by applied EXPAND decisions (see CompanyDecision).
  decisionValue         Float                 @default(0)
  pricingStrategy       String                @default("balanced")
  lobbyBuffType         String?
  lobbyBuffUntilIxTime  Float?
  creditDrawn           Float                 @default(0)
  creditRating          String                @default("A")
  lastTradePrice        Float?
  lastTradeIxTime       Float?
  lastTickRevenue       Float                 @default(0)
  lastTickExpenses      Float                 @default(0)
  lastTickTax           Float                 @default(0)
  lastTickNetIncome     Float                 @default(0)
  distressedSinceIxTime Float?
  wikiSlug              String?
  wikiData              Json?
  status                String                @default("ACTIVE")
  createdIxTime         Float
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  founder               User                  @relation("UserCompaniesFounded", fields: [founderId], references: [id], onDelete: Cascade)
  valueHistory          CompanyValueHistory[]
  issuances             ShareIssuance[]
  shareholdings         Shareholding[]
  decisions             CompanyDecision[]
  bids                  ContractBid[]
  issuedContracts       Contract[]            @relation("ContractIssuer")
  shareListings         ShareListing[]
  shareBuyOrders        ShareBuyOrder[]
  dividends             CompanyDividend[]
  proposals             CompanyProposal[]

  @@unique([realmId, name])
  @@index([founderId])
  @@index([sectorKey])
  @@index([status])
  @@index([realmId, status])
  @@index([hqCountryId])
  @@index([wikiSlug])
  @@map("exchange_companies")
}

/// Persisted fair-value history per company (mirrors CardValueHistory). The breakdown
/// JSON captures the per-component contribution (sector / decisions / standing / contracts)
/// for the MyPortfolio legibility panel (P0-7).
model CompanyValueHistory {
  id            String   @id @default(cuid())
  companyId     String
  fairValue     Float
  breakdown     Json?
  recordedIxTime Float
  recordedAt    DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([recordedIxTime])
  @@map("exchange_company_value_history")
}

/// Primary share issuance record (P0-5). Founder issues shares at the fair-value anchor.
model ShareIssuance {
  id           String   @id @default(cuid())
  companyId    String
  shares       Int
  pricePerShare Float
  issuedIxTime Float
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("exchange_share_issuances")
}

/// A fixed-price sell order for a company's shares. sellerUserId NULL is a primary issue
/// (new shares sold by the company, proceeds to its capital); otherwise a holder's secondary
/// listing, whose shares are escrowed out of their Shareholding until sold or cancelled.
/// status: OPEN | FILLED | CANCELLED. `shares` is what is left to sell.
model ShareListing {
  id             String   @id @default(cuid())
  companyId      String
  sellerUserId   String?
  shares         Int
  sharesListed   Int
  pricePerShare  Float
  status         String   @default("OPEN")
  createdIxTime  Float
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([sellerUserId])
  @@index([status])
  @@map("exchange_share_listings")
}

/// A dividend paid from a company's capital pro rata to its shareholders. `amount` is what
/// was paid: the declared amount less the sub-cent remainder, which stays in capital.
model CompanyDividend {
  id               String   @id @default(cuid())
  companyId        String
  declaredByUserId String
  declared         Float
  amount           Float
  shareCount       Int
  holderCount      Int
  ixTime           Float
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("exchange_company_dividends")
}

/// A player's holding in a company's shares.
model Shareholding {
  id          String   @id @default(cuid())
  companyId   String
  ownerUserId String
  shares      Int      @default(0)
  avgCost     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner       User     @relation("UserShareholdings", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([companyId, ownerUserId])
  @@index([ownerUserId])
  @@map("exchange_shareholdings")
}

/// One of the 4 sim-driven macro-sector indices (Agriculture / Industry / Services /
/// Government) per realm, aggregated from SectoralOutput across the realm's nations. baseTotal
/// is the epoch reference captured on first compute; dmModifier is a DM event lever. macroWeight
/// is the realm's aggregated national sector GDP share.
model SectorIndex {
  id            String   @id @default(cuid())
  realmId       String   @default("default")
  sectorKey     String
  label         String
  value         Float    @default(1000)
  baseTotal     Float?
  dmModifier    Float    @default(0)
  macroWeight   Float    @default(0)
  computedIxTime Float?
  /// The sector fund: ₷ held for SectorPosition holders and the units they own. Each index
  /// update rebalances the four funds by relative index performance; no ₷ is created.
  fundSovereigns   Float @default(0)
  unitsOutstanding Float @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([realmId, sectorKey])
  @@map("exchange_sector_indices")
}

/// Persisted price history per sector index (mirrors CardValueHistory).
model SectorIndexHistory {
  id            String   @id @default(cuid())
  realmId       String   @default("default")
  sectorKey     String
  value         Float
  recordedIxTime Float
  recordedAt    DateTime @default(now())

  @@index([sectorKey])
  @@index([recordedIxTime])
  @@index([realmId])
  @@map("exchange_sector_index_history")
}

/// A player's position in a realm's sector index instrument.
model SectorPosition {
  id          String   @id @default(cuid())
  ownerUserId String
  realmId     String   @default("default")
  sectorKey   String
  units       Float    @default(0)
  avgCost     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  owner       User     @relation("UserSectorPositions", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, realmId, sectorKey])
  @@index([ownerUserId])
  @@map("exchange_sector_positions")
}

/// Convert bridge audit + credit-sink record. direction: CONVERT_IN (IxCredits→Sovereign)
/// | CONVERT_OUT (Sovereign→IxCredits). rate/fee are the values applied at conversion time.
model ConversionLog {
  id         String   @id @default(cuid())
  userId     String
  direction  String
  ixCredits  Float
  sovereigns Float
  rate       Float
  fee        Float
  ixTime     Float
  createdAt  DateTime @default(now())
  /// A retried conversion with the same key is applied once.
  idempotencyKey String? @unique
  user       User     @relation("UserConversionLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([direction, createdAt])
  @@map("exchange_conversion_logs")
}

/// A periodic strategic decision queued by a founder, resolved on the market tick (real time).
/// type: EXPAND | RND | ENTER_SECTOR | ACQUIRE | LOBBY | PRICE
model CompanyDecision {
  id           String   @id @default(cuid())
  companyId    String
  type         String
  payload      Json?
  effect       Json?
  submittedIxTime Float
  appliedIxTime Float?
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([appliedIxTime])
  @@map("exchange_company_decisions")
}

/// A B2G/B2B contract companies can bid on. type: B2G | B2B.
/// status: OPEN | AWARDED | COMPLETED | CANCELLED | DISPUTED (see
/// docs/specs/2026-10-06-exchange-economy-design.md). A B2B contract is issued by a company
/// whose capital funds `escrow` at creation; the winning bid's amount is paid out of escrow.
model Contract {
  id          String        @id @default(cuid())
  realmId     String        @default("default")
  type        String
  title       String
  sectorKey   String
  value       Float
  status      String        @default("OPEN")
  winnerCompanyId String?
  endIxTime   Float
  createdIxTime Float
  createdAt   DateTime      @default(now())
  bids        ContractBid[]
  issuerCompanyId  String?
  issuerUserId     String?
  description      String?
  escrow           Float    @default(0)
  awardedBidId     String?
  disputeReason    String?
  disputedByUserId String?
  resolutionNote   String?
  closedIxTime     Float?
  idempotencyKey   String?  @unique
  updatedAt        DateTime @default(now()) @updatedAt
  /// B2G: the nation the tender is issued for (its owner posts and funds it).
  issuerCountryId  String?
  /// Where escrow came from and returns to: COMPANY (issuer capital) | WALLET (issuer's wallet) |
  /// TREASURY (the issuing nation's treasury) | FAUCET (a realm faucet tender). NULL on MVP rows,
  /// which are all COMPANY.
  fundedBy         String?
  /// The national Directive or Issue this B2G tender was issued from, when there is one.
  linkedDirectiveId String?
  linkedIssueId     String?
  /// Cross-border tariff charged on the award, and the amount actually paid into the treasury.
  tariffRate       Float    @default(0)
  tariffPaid       Float    @default(0)
  issuerCompany    Company? @relation("ContractIssuer", fields: [issuerCompanyId], references: [id], onDelete: SetNull)

  @@index([issuerCompanyId])
  @@index([issuerCountryId])
  @@index([status, endIxTime])
  @@index([winnerCompanyId])
  @@index([status])
  @@index([realmId, status])
  @@index([sectorKey])
  @@index([endIxTime])
  @@map("exchange_contracts")
}

/// A company's bid on a contract. outcome: WON | LOST (set on resolution).
model ContractBid {
  id           String   @id @default(cuid())
  contractId   String
  companyId    String
  amount       Float
  outcome      String?
  standingDelta Float    @default(0)
  createdIxTime Float
  createdAt    DateTime @default(now())
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contractId, companyId])
  @@index([companyId])
  @@map("exchange_contract_bids")
}

/// A nation's ₷ treasury. Filled by stipends, taxes, tariffs and interest, drained by B2G
/// tenders and LOBBY spending. Every move also writes a NationTreasuryEntry.
model NationTreasury {
  id                     String   @id @default(cuid())
  countryId              String   @unique
  realmId                String   @default("default")
  balance                Float    @default(0)
  lifetimeStipend        Float    @default(0)
  lifetimeTaxEarned      Float    @default(0)
  lifetimeTariffEarned   Float    @default(0)
  lifetimeInterestEarned Float    @default(0)
  lifetimeSpent          Float    @default(0)
  corporateGdpShift      Float    @default(0)
  lastStipendIxTime      Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([realmId])
  @@map("exchange_nation_treasuries")
}

/// Audit ledger for NationTreasury moves. type: STIPEND | TAX | TARIFF | INTEREST | LOBBY |
/// B2G_ESCROW | B2G_REFUND | SPEND. amount is signed (positive into the treasury).
/// idempotencyKey: a retried move with the same key is applied once.
model NationTreasuryEntry {
  id             String   @id @default(cuid())
  countryId      String
  type           String
  amount         Float
  balanceAfter   Float
  source         String
  metadata       Json?
  ixTime         Float
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([countryId, createdAt])
  @@map("exchange_nation_treasury_entries")
}

/// A limit bid to buy a company's shares at or below maxPricePerShare. buyerUserId's ₷ is
/// escrowed up front (escrow). status: OPEN | FILLED | CANCELLED. `shares` is what is left
/// to buy and `sharesOrdered` is the original order size.
model ShareBuyOrder {
  id               String   @id @default(cuid())
  companyId        String
  buyerUserId      String
  shares           Int
  sharesOrdered    Int
  maxPricePerShare Float
  escrow           Float
  status           String   @default("OPEN")
  createdIxTime    Float
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([buyerUserId])
  @@map("exchange_share_buy_orders")
}

/// A shareholder vote on a company action. type: DISSOLVE | ISSUE_SHARES | ACQUIRE_OFFER.
/// status: OPEN | PASSED | REJECTED | EXPIRED. Votes are weighted by shares held.
model CompanyProposal {
  id                  String        @id @default(cuid())
  companyId           String
  proposerUserId      String
  type                String
  payload             Json
  status              String        @default("OPEN")
  sharesFor           Int           @default(0)
  sharesAgainst       Int           @default(0)
  totalEligibleShares Int
  expiresIxTime       Float
  resolvedIxTime      Float?
  idempotencyKey      String?       @unique
  createdAt           DateTime      @default(now())
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  votes               CompanyVote[]

  @@index([companyId, status])
  @@map("exchange_company_proposals")
}

/// One voter's weighted ballot on a CompanyProposal.
model CompanyVote {
  id          String          @id @default(cuid())
  proposalId  String
  voterUserId String
  support     Boolean
  shares      Int
  createdAt   DateTime        @default(now())
  proposal    CompanyProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, voterUserId])
  @@index([voterUserId])
  @@map("exchange_company_votes")
}
