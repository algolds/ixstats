// IxStates — Military & Security models

/// A branch of a nation's armed forces (realm time D2). The player names it; its domain sets capital intensity,
/// depreciation and training needs. Headcounts, capital and readiness are derived from the defense budget and time
/// on the nation's realm clock (`~/lib/military/model`), never typed by the player.
model MilitaryBranch {
  id                         String             @id @default(cuid())
  countryId                  String
  domain                     BranchDomain
  name                       String
  motto                      String?
  imageUrl                   String?
  description                String?
  established                String?
  /// Active personnel N (fractional so slow monthly adjustments never stall on rounding).
  activeDuty                 Float              @default(0)
  /// Reservists Rv.
  reserves                   Float              @default(0)
  civilianStaff              Int                @default(0)
  /// The player's effort weight across branches (normalised).
  effortShare                Float              @default(0)
  /// The player's desired active strength; null follows what the budget affords.
  targetActive               Int?
  /// Real capital stock K (catalog price units at the reset).
  capital                    Float              @default(0)
  /// Readiness sub-scores in [0, 1] at the last tick: personnel fill P, equipment on hand S, condition Rc, training T.
  readinessPersonnel         Float              @default(0)
  readinessEquipment         Float              @default(0)
  readinessCondition         Float              @default(0)
  readinessTraining          Float              @default(0)
  reserveTraining            Float              @default(0)
  /// Reservists ordered to mobilise and when (realm clock ms); `mobilised` is who had reported at the last tick.
  mobilisationOrder          Int                @default(0)
  mobilisationOrderedClockMs Float?
  mobilised                  Float              @default(0)
  /// Realm clock ms of the last monthly tick (mirrors the nation's DefensePolicy.lastTickClockMs).
  lastTickClockMs            Float              @default(0)
  isActive                   Boolean            @default(true)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  assets                     MilitaryAsset[]
  country                    Country            @relation("CountryMilitaryBranches", fields: [countryId], references: [id], onDelete: Cascade)
  units                      MilitaryUnit[]
  procurementOrders          ProcurementOrder[]

  @@index([countryId])
  @@index([domain])
  @@index([isActive])
}

model MilitaryUnit {
  id            String          @id @default(cuid())
  branchId      String
  name          String
  unitType      String
  designation   String?
  description   String?
  personnel     Int             @default(0)
  commanderName String?
  commanderRank String?
  headquarters  String?
  imageUrl      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  assets        MilitaryAsset[]
  branch        MilitaryBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model MilitaryAsset {
  id                 String         @id @default(cuid())
  branchId           String
  unitId             String?
  name               String
  assetType          AssetType
  category           String
  status             AssetStatus    @default(operational)
  quantity           Int            @default(1)
  operational        Int            @default(1)
  acquisitionCost    Float          @default(0)
  maintenanceCost    Float          @default(0)
  /// The catalog item it was procured as, and that design's year (quality decays against the realm frontier).
  catalogKey         String?
  designYear         Int?
  capability         String?
  imageUrl           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  branch             MilitaryBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  unit               MilitaryUnit?  @relation(fields: [unitId], references: [id])

  @@index([branchId])
  @@index([unitId])
  @@index([assetType])
  @@index([status])
  @@index([catalogKey])
}

model InternalStabilityMetrics {
  id                      String   @id @default(cuid())
  countryId               String   @unique
  stabilityScore          Float    @default(75)
  stabilityTrend          String   @default("stable")
  crimeRate               Float    @default(5)
  violentCrimeRate        Float    @default(2)
  propertyCrimeRate       Float    @default(10)
  organizedCrimeLevel     Float    @default(3)
  policingEffectiveness   Float    @default(60)
  justiceSystemEfficiency Float    @default(50)
  protestFrequency        Float    @default(5)
  riotRisk                Float    @default(10)
  civilDisobedience       Float    @default(5)
  socialCohesion          Float    @default(70)
  ethnicTension           Float    @default(20)
  politicalPolarization   Float    @default(40)
  trustInGovernment       Float    @default(50)
  trustInPolice           Float    @default(55)
  fearOfCrime             Float    @default(35)
  /// JSON of the formula values the last recalculation produced; the gap between a stored
  /// field and its formula value here is the event (issue/directive) delta to carry forward.
  formulaSnapshot         String?
  lastCalculated          DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  country                 Country  @relation("CountryStabilityMetrics", fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
}

model MilitaryEquipmentCatalog {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  manufacturer      String
  category          String
  subcategory       String?
  era               String
  specifications    String
  capabilities      String
  acquisitionCost   Float
  maintenanceCost   Float
  technologyLevel   Int
  crewRequirement   Int
  maintenanceHours  Int?
  imageUrl          String?
  description       String?
  historicalContext String?
  isActive          Boolean  @default(true)
  usageCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category, era])
  @@index([manufacturer])
  @@index([technologyLevel])
  @@index([isActive, usageCount])
}

model DefenseManufacturer {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  country   String
  specialty String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([isActive])
}

model SmallArmsManufacturer {
  id        String               @id @default(cuid())
  key       String               @unique
  name      String
  country   String
  specialty String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  equipment SmallArmsEquipment[]

  @@index([country])
  @@index([isActive])
}

model WeaponEra {
  id          String               @id @default(cuid())
  key         String               @unique
  label       String
  years       String
  reliability Int
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  equipment   SmallArmsEquipment[]

  @@index([isActive])
}

model SmallArmsEquipment {
  id              String                @id @default(cuid())
  key             String                @unique
  name            String
  manufacturerKey String
  category        String
  equipmentType   String
  eraKey          String
  weight          Float
  unitCost        Float
  maintenanceCost Float
  imageUrl        String?
  caliber         String?
  capacity        Int?
  effectiveRange  Int?
  fireRate        Int?
  protectionLevel String?
  range           Int?
  altitude        Int?
  description     String?
  isActive        Boolean               @default(true)
  usageCount      Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  era             WeaponEra             @relation(fields: [eraKey], references: [key])
  manufacturer    SmallArmsManufacturer @relation(fields: [manufacturerKey], references: [key])

  @@index([equipmentType, eraKey])
  @@index([manufacturerKey])
  @@index([category])
  @@index([eraKey])
  @@index([isActive, usageCount])
  @@index([equipmentType, category])
  @@index([unitCost])
}

model MilitaryOperation {
  id                String       @id @default(cuid())
  countryId         String
  operationType     String       // "peacekeeping", "defense_pact", "blockade", "intervention", "training"
  name              String
  description       String?
  targetCountryId   String?
  allianceId        String?
  status            String       @default("planned") // "planned", "active", "completed", "failed", "cancelled"
  startIxTime       Float        @default(0)
  endIxTime         Float?
  duration          Int?         // Planned duration in IxTime days
  personnelDeployed Int          @default(0)
  assetsDeployed    String?      // JSON array of MilitaryAsset IDs
  dailyCost         Float        @default(0)
  totalCostSoFar    Float        @default(0)
  gdpDrain          Float        @default(0) // Percentage of GDP consumed
  readinessImpact   Float        @default(-10)
  successRating     String?      // "success", "partial", "failure"
  diplomaticImpact  Int          @default(0)
  casualties        Int          @default(0)
  /// An intervention resolves on the combat model at its end: the seed fixed at launch with its orders hash and commit
  /// time (realm clock ms), the inputs snapshot (server only) and the outcome band.
  orders            String?
  ordersHash        String?
  committedClockMs  Float?
  seed              String?
  inputSnapshot     String?
  outcomeBand       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  country           Country      @relation("CountryMilitaryOperations", fields: [countryId], references: [id], onDelete: Cascade)
  targetCountry     Country?     @relation("MilitaryOperationTarget", fields: [targetCountryId], references: [id])
  deployments       Deployment[]

  @@index([countryId])
  @@index([targetCountryId])
  @@index([operationType])
  @@index([status])
  @@index([startIxTime])
}

model Deployment {
  id          String            @id @default(cuid())
  operationId String
  unitId      String?
  assetId     String?
  status      String            @default("deployed") // "deployed", "recalled", "lost"
  deployedAt  DateTime          @default(now())
  recalledAt  DateTime?

  operation   MilitaryOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([unitId])
  @@index([assetId])
}

model MilitaryConflict {
  id                  String   @id @default(cuid())
  type                String   // "pvp", "pvnpc"
  initiatorId         String
  defenderId          String
  status              String   @default("proposed") // "proposed", "accepted", "active", "resolved"
  pvpRules            String?  // JSON: { victoryConditions, maxDuration, stakes }
  initiatorApproved   Boolean  @default(false)
  defenderApproved    Boolean  @default(false)
  reason              String?
  startDate           DateTime?
  /// Realm clock ms when hostilities began (the PvP window runs on the realm clock).
  startClockMs        Float?
  endDate             DateTime?
  winner              String?  // Country ID or "draw"
  initiatorCasualties Int      @default(0)
  defenderCasualties  Int      @default(0)
  economicDamage      Float    @default(0)
  /// Combat resolution: the initiator's orders (JSON) and their hash, the commit time (realm clock ms), the HMAC seed
  /// fixed at commit (never rerolled; shown once resolved), the inputs snapshot a replay recomputes from (server only),
  /// and the result.
  orders              String?
  ordersHash          String?
  committedClockMs    Float?
  seed                String?
  inputSnapshot       String?
  outcomeBand         String?
  margin              Float?
  engagementDays      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  initiator           Country  @relation("ConflictInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  defender            Country  @relation("ConflictDefender", fields: [defenderId], references: [id], onDelete: Cascade)

  @@index([initiatorId])
  @@index([defenderId])
  @@index([status])
  @@index([type])
}

/// A nation's defense policy and national defense stocks (realm time D2, design §4.2). Created with the nation's
/// starter force; the monthly tick on the nation's realm clock advances the stocks.
model DefensePolicy {
  id                  String            @id @default(cuid())
  countryId           String            @unique
  /// Budget split of the Defense line; sums to 1.
  sharePersonnel      Float             @default(0.35)
  shareOm             Float             @default(0.3)
  shareProcurement    Float             @default(0.22)
  shareRd             Float             @default(0.06)
  shareInfrastructure Float             @default(0.07)
  /// The preset last applied ("professional", "territorial", "rearm"), null once edited.
  preset              String?
  /// Manpower model: volunteer share v (1 all-volunteer, 0 conscription), service months, reserve obligation years.
  volunteerShare      Float             @default(1)
  serviceMonths       Int               @default(12)
  reserveYears        Int               @default(20)
  doctrine            DefenseDoctrine   @default(balanced)
  /// Ordered alert level; a raise bites after its days (7 Elevated … 30 War) from alertChangedClockMs.
  alertLevel          DefenseAlertLevel @default(peacetime)
  previousAlertLevel  DefenseAlertLevel @default(peacetime)
  alertChangedClockMs Float             @default(0)
  omPriority          DefenseOmPriority @default(balanced)
  /// R&D and infrastructure stocks (real) and the catalog price index.
  rdStock             Float             @default(0)
  infrastructureStock Float             @default(0)
  priceIndex          Float             @default(1)
  surgeStartedClockMs Float?
  /// The defender's declared terrain ("open" … "mountain", "+river" for a river line), used where the map has none.
  terrainProfile      String?
  /// An NPC's Richardson response to threats: burden added to its budget's share of GDP (players stay 0).
  npcBurdenAdjustment Float             @default(0)
  lastTickClockMs     Float             @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  country             Country           @relation("CountryDefensePolicy", fields: [countryId], references: [id], onDelete: Cascade)
}

/// A catalog procurement order: paid 15% down then over its lead time, delivered into the branch's capital and
/// assets on the nation's realm clock.
model ProcurementOrder {
  id               String            @id @default(cuid())
  countryId        String
  branchId         String
  catalogKey       String
  quantity         Int
  /// Nominal unit cost now (grows 0.5% for every month the order slips).
  unitCost         Float
  /// Real replacement value of one unit (enters the branch's capital on delivery).
  unitRealValue    Float
  source           ProcurementSource
  leadMonths       Int
  designYear       Int
  orderedClockMs   Float
  expectedClockMs  Float
  paidSoFar        Float             @default(0)
  status           ProcurementStatus @default(ordered)
  deliveredClockMs Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  branch           MilitaryBranch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([countryId, status])
  @@index([branchId])
}

enum BranchDomain {
  land
  sea
  air
  marines
  space
  strategic_missile
}

enum DefenseDoctrine {
  defensive
  balanced
  expeditionary
}

enum DefenseAlertLevel {
  peacetime
  elevated
  high
  war
}

enum DefenseOmPriority {
  balanced
  maintenance
  training
}

enum ProcurementSource {
  domestic
  import
}

enum ProcurementStatus {
  ordered
  delivered
  cancelled
}
