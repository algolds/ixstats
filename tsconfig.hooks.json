{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist/hooks",
    "rootDir": "./src/hooks",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": [],
    "isolatedModules": true
  },
  "include": [
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    { "path": "./tsconfig.lib.json" }
  ]
}
