{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{"name": "next"}],
    "types": ["node"]
  },
  "include": [
    "src/components/**/*",
    "src/app/**/*",
    "src/hooks/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/.*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
