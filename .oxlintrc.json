{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import", "oxc", "jest", "nextjs", "jsx-a11y"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "rules": {
    // Unused vars - phased cleanup (2037->0): off for now, ratchet via maxWarnings; use ^_ prefix convention per AGENTS.md
    "eslint/no-unused-vars": "off",
    "typescript/no-unused-vars": "off",
    // TS relaxed
    "typescript/no-explicit-any": "off",
    "typescript/no-empty-function": "off",
    "typescript/ban-ts-comment": "warn",
    "typescript/no-require-imports": "off",
    // React hooks correctness — keep rules-of-hooks as error, rest off for clean (incremental fix in follow-up)
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "off",
    "react/set-state-in-effect": "off",
    // React 19 new JSX runtime - React import not required
    "react/react-in-jsx-scope": "off",
    // Next.js handles <a> etc - relax a11y/next for now (was off in ESLint, keep pre-existing)
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/img-redundant-alt": "off",
    "jsx-a11y/role-has-required-aria-props": "off",
    "jsx-a11y/role-supports-aria-props": "off",
    "jsx-a11y/heading-has-content": "off",
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/anchor-has-content": "off",
    "nextjs/no-img-element": "off",
    // Pedantic noise downgraded — ~650 diags without code touch (Phase 0 ratchet)
    "eslint/no-underscore-dangle": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-add-event-listener": "off",
    "typescript/no-extraneous-class": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/immutability": "off",
    "react/hooks": "off",
    "react/static-components": "off",
    "react/preserve-manual-memoization": "off",
    "react/use-memo": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/no-unstable-nested-components": "off",
    "react/memo-dependencies": "off",
    "react/iframe-missing-sandbox": "off",
    "oxc/only-used-in-recursion": "off",
    // General
    "eslint/no-console": "off",
    "eslint/prefer-const": "off",
    "eslint/no-var": "error",
    "eslint/no-shadow": "off",
    "eslint/eqeqeq": ["warn", "always", { "null": "ignore" }],
    "eslint/no-useless-escape": "off",
    "eslint/no-control-regex": "off",
    "eslint/no-misleading-character-class": "off",
    "eslint/no-constant-binary-expression": "off",
    "eslint/no-unassigned-vars": "off",
    "eslint/no-unneeded-ternary": "off",
    "eslint/no-constant-condition": "off",
    "eslint/no-eval": "off",
    "eslint/no-unused-expressions": "off",
    "eslint/no-unmodified-loop-condition": "off",
    "eslint/no-new": "off",
    "eslint/no-duplicate-case": "off",
    "react/jsx-no-comment-textnodes": "off",
    "react/capitalized-calls": "off",
    "react/incompatible-library": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-useless-length-check": "off",
    "unicorn/require-post-message-target-origin": "off",
    "jsx-a11y/anchor-is-valid": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "oxc/const-comparisons": "off",
    "oxc/erasing-op": "off",
    "nextjs/no-assign-module-variable": "off",
    "nextjs/no-html-link-for-pages": "off",
    // Import hygiene - warn only (import plugin heavier)
    "import/no-cycle": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off"
  },
  "options": { "maxWarnings": 0 },
  "settings": {
    "jsx-a11y": { "components": { "Link": "a", "Button": "button" } }
  },
  "env": {
    "browser": true,
    "node": true,
    "builtin": true
  },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "out/**",
    ".next/types/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**",
    "prisma/**",
    "*.config.js",
    "*.config.ts",
    "*.config.mjs",
    "server.mjs",
    "coverage/**",
    "public/**"
  ],
  "overrides": [
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "**/__tests__/**"],
      "plugins": ["jest"],
      "rules": {
        "jest/no-disabled-tests": "warn",
        "jest/no-focused-tests": "error"
      }
    }
  ]
}
