{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsbuildinfo",
    /* `paths` is not merged with the base config, so the app aliases are repeated here. */
    "paths": {
      "server-only": [
        "./jest-mocks/server-only.ts"
      ],
      "*": [
        "./*"
      ],
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@turf/turf": [
        "./node_modules/@turf/turf/index.d.ts"
      ]
    },
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    /* Test fixtures, including the audit-arch fake source trees that are broken on purpose. The tests stay included for the editor. */
    "src/tests/fixtures",
    "**/node_modules",
    "**/.*",
    "public",
    "docs",
    "prisma/migrations",
    "prisma/backups",
    "scripts",
    ".next/cache",
    ".next/server",
    ".next/static",
    ".next/standalone",
    ".next/diagnostics",
    "dist",
    "build",
    "out",
    "coverage",
    "odysseus"
  ],
  "typeAcquisition": {
    "enable": false
  }
}
