# maps.ixwiki.com — IxWorld interactive map (standalone mode)
# Proxies to the SAME Next.js process as ixstates.ixwiki.com on port 3550
# Runtime hostname detection in proxy.ts restricts routes to maps-only
#
# NOTE: X-Forwarded-Host header is CRITICAL — the app uses it to detect standalone mode

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name maps.ixwiki.com;
    return 301 https://$host$request_uri;
}

# HTTPS server block
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name maps.ixwiki.com;

    # SSL certificates (shared with main ixwiki.com)
    ssl_certificate /etc/letsencrypt/live/ixwiki.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ixwiki.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Client settings
    client_max_body_size 20M;

    # Cloudflare real IP handling
    real_ip_header CF-Connecting-IP;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/12;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Logging
    access_log /var/log/nginx/maps.ixwiki.com-access.log;
    error_log /var/log/nginx/maps.ixwiki.com-error.log;

    # tRPC API — larger buffers for GeoJSON responses (3.5MB+)
    location /api/trpc/ {
        proxy_pass http://127.0.0.1:3550;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_buffering on;
        proxy_buffer_size 32k;
        proxy_buffers 64 128k;
        proxy_busy_buffers_size 512k;
        proxy_max_temp_file_size 50m;

        proxy_connect_timeout 30s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Next.js static assets — immutable cache
    location /_next/static {
        proxy_pass http://127.0.0.1:3550;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # ── Legacy IxMaps (Leaflet) at /legacy ─────────────────────
    location /legacy/ {
        rewrite ^/legacy/(.*) /$1 break;
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location = /legacy {
        return 301 /legacy/;
    }

    # Default — proxy all to Next.js (same port as IxStates, hostname distinguishes)
    location / {
        proxy_pass http://127.0.0.1:3550;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_buffer_size 16k;
        proxy_buffers 32 128k;
        proxy_busy_buffers_size 256k;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Favicon
    location /favicon.ico {
        proxy_pass http://127.0.0.1:3550;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        access_log off;
        add_header Cache-Control "public, max-age=86400";
    }
}
